---
// Reusable SVG Wallet and Payment Icons Component
interface Props {
  className?: string;
}
const { className = '' } = Astro.props;
---

<div class={`wallet-icons-group ${className}`} aria-label="Accepted secure payment methods">
  <!-- Apple Pay -->
  <span class="wallet-badge" title="Apple Pay">
    <svg width="34" height="20" viewBox="0 0 34 20" fill="none" xmlns="http://www.w3.org/2000/svg">
      <rect width="34" height="20" rx="3" fill="#FFFFFF" stroke="#DCD4C7"/>
      <path d="M12.3 8.3c-.3.4-.8.6-1.3.6-.1-.5.1-1 .4-1.3.3-.4.8-.6 1.3-.6.1.5-.1 1-.4 1.3zm1.4 4.5c-.3.4-.6.8-1 .8-.5 0-.7-.3-1.3-.3s-.8.3-1.3.3c-.5 0-.8-.4-1.1-.8-.7-1-.9-2.3-.3-3.2.4-.6 1-.9 1.6-.9.5 0 .8.3 1.2.3.4 0 .6-.3 1.2-.3.6 0 1.2.3 1.5.8-.8.5-.9 1.6-.3 2.3-.3.6-.6 1.1-.9 1.6zM15.4 7.6h1.2v6.6h-1.2V7.6zm4.8 4.3c0 .8-.5 1.4-1.4 1.4h-.9v-4h1c.8 0 1.3.5 1.3 1.3v1.3zm-1.1-.5v-.9h-.2v.9h.2zm3.9 1.9c-.3.2-.8.3-1.3.3-1 0-1.6-.6-1.6-1.7V9.7h-.6V8.9h.6V8.1l1.1-.3v1.1h1.1v.8h-1.1v2.1c0 .5.2.8.7.8.2 0 .4 0 .5-.1v.8z" fill="#2B2521"/>
    </svg>
  </span>

  <!-- Google Pay -->
  <span class="wallet-badge" title="Google Pay">
    <svg width="34" height="20" viewBox="0 0 34 20" fill="none" xmlns="http://www.w3.org/2000/svg">
      <rect width="34" height="20" rx="3" fill="#FFFFFF" stroke="#DCD4C7"/>
      <path d="M12.4 10.1v2.4h-.8V7.5h2.1c.5 0 .9.2 1.2.5.4.3.5.7.5 1.2 0 .5-.2.9-.5 1.2-.3.3-.7.5-1.2.5h-1.3v-.8zm0-1.8h1.3c.3 0 .5-.1.7-.3.2-.2.3-.4.3-.6 0-.3-.1-.5-.3-.6-.2-.2-.4-.3-.7-.3h-1.3v1.8zm6.5 1.2c0 .6-.2 1.1-.6 1.4-.4.4-.9.6-1.5.6-.5 0-.9-.1-1.3-.4-.4-.3-.6-.7-.6-1.1 0-.5.2-.9.6-1.2.4-.3.9-.4 1.5-.4.5 0 .9.1 1.2.3v-.2c0-.3-.1-.5-.3-.6-.2-.2-.4-.2-.7-.2-.4 0-.7.1-.9.3l-.3-.6c.4-.3.8-.4 1.4-.4.6 0 1.1.2 1.4.5.4.4.6.9.6 1.5v2.8h-.8v-.7h-.1zm-1.4.5c-.3 0-.6.1-.8.2-.2.1-.3.3-.3.6 0 .2.1.4.3.5.2.1.4.2.7.2.3 0 .6-.1.8-.3.2-.2.3-.5.3-.8-.3-.2-.7-.4-1.3-.4z" fill="#5F6368"/>
    </svg>
  </span>

  <!-- PayPal -->
  <span class="wallet-badge" title="PayPal">
    <svg width="34" height="20" viewBox="0 0 34 20" fill="none" xmlns="http://www.w3.org/2000/svg">
      <rect width="34" height="20" rx="3" fill="#FFFFFF" stroke="#DCD4C7"/>
      <path d="M11 6.5h3.2c1.4 0 2.2.7 2 2-.2 1.5-1.3 2.3-2.6 2.3h-1.1l-.7 4.2H10L11 6.5zm2.8 3.3c.7 0 1.2-.4 1.3-1.1.1-.6-.3-1-.9-1h-1.4l-.4 2.1h1.4z" fill="#003087"/>
      <path d="M13.2 8h3.2c1.4 0 2.2.7 2 2-.2 1.5-1.3 2.3-2.6 2.3h-1.1l-.7 4.2h-1.8L13.2 8zm2.8 3.3c.7 0 1.2-.4 1.3-1.1.1-.6-.3-1-.9-1H15l-.4 2.1h1.4z" fill="#0079C1"/>
    </svg>
  </span>

  <!-- Visa / Card -->
  <span class="wallet-badge" title="Visa / Mastercard">
    <svg width="34" height="20" viewBox="0 0 34 20" fill="none" xmlns="http://www.w3.org/2000/svg">
      <rect width="34" height="20" rx="3" fill="#FFFFFF" stroke="#DCD4C7"/>
      <circle cx="14" cy="10" r="4.5" fill="#EB001B" fill-opacity="0.85"/>
      <circle cx="20" cy="10" r="4.5" fill="#F79E1B" fill-opacity="0.85"/>
    </svg>
  </span>
</div>

<style>
  .wallet-icons-group {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.35rem;
    flex-wrap: wrap;
  }
  .wallet-badge {
    display: inline-flex;
    align-items: center;
    line-height: 0;
  }
</style>
