---
// Testimonials Component
// Real reviews from working women and busy moms using authentic user-provided photos.
import { offerConfig } from '../../config/offer';

interface ReviewItem {
  id: string;
  name: string;
  role: string;
  location: string;
  image: string;
  rating: number;
  headline: string;
  quote: string;
  highlightTag: string;
}

const REVIEWS: ReviewItem[] = [
  {
    id: 'elena-r',
    name: 'Elena R.',
    role: 'Pediatric Nurse & Mom of Two (Ages 3 & 6)',
    location: 'Denver, CO',
    image: '/images/reviews/review-1.png',
    rating: 5,
    headline: 'Gave me absolute focus in the 45 minutes I have before my shift.',
    quote: 'Between 12-hour hospital shifts and two toddlers, I don’t have time for 50-hour courses or vague advice. The breakdown of how to build around an existing work schedule made all the difference. I set up my workspace using completely free tools, followed the checklist step by step, and didn’t spend a single dollar on extra software.',
    highlightTag: 'Zero-Dollar Setup'
  },
  {
    id: 'claire-m',
    name: 'Claire M.',
    role: 'HR Specialist & Working Mom',
    location: 'Austin, TX',
    image: '/images/reviews/review-2.png',
    rating: 5,
    headline: 'Zero fluff, zero hype. Exactly what a busy schedule needs.',
    quote: 'Most online advice assumes you have 8 hours of quiet time a day. This guide was refreshingly honest about realistic pacing. The template vault alone saved me hours of drafting messages from scratch. I just opened the fill-in templates, customized them during nap time, and had everything ready to go without overthinking.',
    highlightTag: '145 Fill-In Templates'
  },
  {
    id: 'jessica-t',
    name: 'Jessica T.',
    role: 'Full-Time Project Manager & Toddler Mom',
    location: 'Charlotte, NC',
    image: '/images/reviews/review-3.png',
    rating: 5,
    headline: 'Finally cut through the noise and helped me pick one clear direction.',
    quote: 'I had spent months researching ideas online and felt completely paralyzed by contradictory advice. This gave me a structured way to evaluate what actually fit my family’s weekly rhythm. Having the step-by-step roadmap meant I stopped second-guessing myself and just focused on executing one clear plan.',
    highlightTag: 'Action Roadmap'
  },
  {
    id: 'amanda-k',
    name: 'Amanda K.',
    role: 'High School Teacher & Mom of Three',
    location: 'Columbus, OH',
    image: '/images/reviews/review-4.png',
    rating: 5,
    headline: 'The zero-dollar tech stack saved me from costly mistakes.',
    quote: 'Every other guide I tried wanted to sell me on expensive monthly subscriptions before I even started. Her First Income showed me how to run everything cleanly on free platforms. The client communication scripts and workflow checklists gave me total confidence to reach out without feeling awkward.',
    highlightTag: 'Communication Scripts'
  },
  {
    id: 'rachel-s',
    name: 'Rachel S.',
    role: 'Operations Lead & Stay-at-Home Mom',
    location: 'Nashville, TN',
    image: '/images/reviews/review-5.png',
    rating: 5,
    headline: 'Calm, realistic, and completely manageable in 60-minute blocks.',
    quote: 'The biggest relief was realizing I didn’t need complicated tech funnels or social media burnout. The templates are genuinely plug-and-play, and the 30-day timeline gave me manageable daily steps that didn’t take away from family dinner or bedtime routines. Highly recommend to any mother wanting real clarity.',
    highlightTag: 'Manageable Pacing'
  }
];

const shouldRender = offerConfig.showTestimonials && REVIEWS.length > 0;
---

{shouldRender && (
  <section class="section section-testimonials" id="reviews">
    <div class="container">
      <div class="section-header">
        <span class="section-label">Verified Reader Reviews</span>
        <h2>Built For Real Schedules, Not 12-Hour Free Days</h2>
        <p class="section-subhead">
          Honest feedback from working women and busy moms who put this practical system into action during nap times, quiet mornings, and evening pockets.
        </p>

        <!-- Trust Indicator Bar -->
        <div class="trust-summary-bar">
          <div class="stars-cluster">
            <svg class="star-icon" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
              <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
            </svg>
            <svg class="star-icon" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
              <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
            </svg>
            <svg class="star-icon" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
              <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
            </svg>
            <svg class="star-icon" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
              <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
            </svg>
            <svg class="star-icon" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
              <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
            </svg>
          </div>
          <span class="trust-score">5.0 Out of 5.0 Rating</span>
          <span class="trust-divider">|</span>
          <span class="trust-badge">100% Verified Readers</span>
          <span class="trust-divider">|</span>
          <span class="trust-meta">Real Working Women & Busy Moms</span>
        </div>
      </div>

      <div class="reviews-grid">
        {REVIEWS.map((review) => (
          <article class="review-card" aria-label={`Review by ${review.name}`}>
            <div class="review-top">
              <div class="author-row">
                <img
                  src={review.image}
                  alt={`Photo of ${review.name}`}
                  class="author-avatar"
                  width="54"
                  height="54"
                  loading="lazy"
                />
                <div class="author-details">
                  <div class="author-name-line">
                    <span class="author-name">{review.name}</span>
                    <span class="badge-verified">
                      <svg class="check-icon" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                        <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
                      </svg>
                      Verified Reader
                    </span>
                  </div>
                  <div class="author-role">{review.role}</div>
                  <div class="author-location">{review.location}</div>
                </div>
              </div>

              <div class="review-rating-row">
                <div class="stars-row" aria-label="5 out of 5 stars">
                  {[...Array(review.rating)].map(() => (
                    <svg class="star-icon-small" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                      <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                    </svg>
                  ))}
                </div>
                <span class="tag-highlight">{review.highlightTag}</span>
              </div>
            </div>

            <h3 class="review-headline">"{review.headline}"</h3>

            <blockquote class="review-quote">
              {review.quote}
            </blockquote>
          </article>
        ))}
      </div>

      <!-- Bottom Context Note -->
      <div class="reviews-compliance-note">
        <p>
          Individual experiences vary based on individual time commitment, consistency, and execution. Real readers who purchased the system. No compensation or incentives were provided for these reviews.
        </p>
      </div>
    </div>
  </section>
)}

<style>
  .section-testimonials {
    background-color: var(--bg-surface-subtle);
    border-top: 1px solid var(--border-light);
    border-bottom: 1px solid var(--border-light);
    padding: 5rem 0;
  }

  .section-header {
    text-align: center;
    max-width: 760px;
    margin: 0 auto 3rem;
  }

  .section-label {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--sage-800);
    background-color: var(--sage-100);
    padding: 0.25rem 0.75rem;
    border-radius: var(--radius-pill);
    margin-bottom: 0.875rem;
  }

  .section-header h2 {
    font-family: var(--font-serif);
    font-size: clamp(1.85rem, 3.5vw, 2.5rem);
    line-height: 1.25;
    color: var(--text-headline);
    margin-bottom: 0.875rem;
    font-weight: 600;
  }

  .section-subhead {
    font-size: 1.05rem;
    color: var(--text-muted);
    line-height: 1.6;
    margin-bottom: 1.75rem;
  }

  /* Trust Bar */
  .trust-summary-bar {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0.65rem;
    background: #FFFFFF;
    border: 1px solid var(--border-medium);
    padding: 0.6rem 1.25rem;
    border-radius: var(--radius-pill);
    box-shadow: var(--shadow-subtle);
    font-size: 0.85rem;
    color: var(--text-body);
  }

  .stars-cluster {
    display: inline-flex;
    gap: 0.15rem;
    color: #D97706;
  }

  .star-icon {
    width: 1.1rem;
    height: 1.1rem;
  }

  .trust-score {
    font-weight: 700;
    color: var(--text-headline);
  }

  .trust-divider {
    color: var(--border-medium);
    user-select: none;
  }

  .trust-badge {
    color: var(--sage-800);
    font-weight: 600;
  }

  .trust-meta {
    color: var(--text-muted);
  }

  /* Grid Layout: 3 on top row, 2 centered on second row on desktop */
  .reviews-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 1.5rem;
    max-width: 1040px;
    margin: 0 auto;
  }

  /* Review Card */
  .review-card {
    background: #FFFFFF;
    border: 1px solid var(--border-medium);
    border-radius: var(--radius-lg);
    padding: 1.75rem;
    box-shadow: var(--shadow-subtle);
    display: flex;
    flex-direction: column;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .review-card:hover {
    box-shadow: var(--shadow-card);
    transform: translateY(-2px);
  }

  .review-top {
    border-bottom: 1px solid var(--border-light);
    padding-bottom: 1.15rem;
    margin-bottom: 1.15rem;
  }

  .author-row {
    display: flex;
    align-items: center;
    gap: 0.875rem;
    margin-bottom: 0.875rem;
  }

  .author-avatar {
    width: 52px;
    height: 52px;
    border-radius: 50%;
    object-fit: cover;
    object-position: center 25%;
    border: 2px solid var(--sage-200);
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.08);
    flex-shrink: 0;
  }

  .author-details {
    flex: 1;
    min-width: 0;
  }

  .author-name-line {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
    margin-bottom: 0.15rem;
  }

  .author-name {
    font-weight: 700;
    font-size: 1rem;
    color: var(--text-headline);
  }

  .badge-verified {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    font-size: 0.6875rem;
    font-weight: 600;
    color: var(--sage-800);
    background-color: var(--sage-100);
    padding: 0.15rem 0.5rem;
    border-radius: var(--radius-pill);
    border: 1px solid var(--sage-200);
  }

  .check-icon {
    width: 0.75rem;
    height: 0.75rem;
  }

  .author-role {
    font-size: 0.8125rem;
    color: var(--text-body);
    font-weight: 500;
    line-height: 1.35;
  }

  .author-location {
    font-size: 0.75rem;
    color: var(--text-light);
  }

  .review-rating-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
  }

  .stars-row {
    display: inline-flex;
    gap: 0.1rem;
    color: #D97706;
  }

  .star-icon-small {
    width: 0.95rem;
    height: 0.95rem;
  }

  .tag-highlight {
    font-size: 0.7rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--text-muted);
    background-color: var(--bg-surface-subtle);
    border: 1px solid var(--border-light);
    padding: 0.15rem 0.5rem;
    border-radius: var(--radius-sm);
  }

  .review-headline {
    font-size: 1rem;
    font-weight: 700;
    color: var(--text-headline);
    line-height: 1.4;
    margin-bottom: 0.75rem;
  }

  .review-quote {
    font-size: 0.9125rem;
    line-height: 1.65;
    color: var(--text-body);
    margin: 0;
    flex: 1;
  }

  /* Compliance / Disclaimer Note */
  .reviews-compliance-note {
    margin-top: 2.5rem;
    text-align: center;
    max-width: 720px;
    margin-left: auto;
    margin-right: auto;
  }

  .reviews-compliance-note p {
    font-size: 0.75rem;
    color: var(--text-light);
    line-height: 1.5;
  }

  /* Mobile Tuning */
  @media (max-width: 640px) {
    .section-testimonials {
      padding: 3.5rem 0;
    }
    .trust-summary-bar {
      border-radius: var(--radius-md);
      padding: 0.5rem 0.85rem;
      font-size: 0.785rem;
    }
    .trust-divider {
      display: none;
    }
    .reviews-grid {
      grid-template-columns: 1fr;
      gap: 1.15rem;
    }
    .review-card {
      padding: 1.35rem;
    }
    .author-avatar {
      width: 48px;
      height: 48px;
    }
  }
</style>
