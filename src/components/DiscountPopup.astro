---
// Limited-Time 45% Discount Popup Modal with 18h Countdown (Both Kits)
import { offerConfig } from '../../config/offer';

const popup = offerConfig.discountPopup;
if (!popup || !popup.enabled) {
  return null;
}
const { starter, complete } = popup;
---

<div
  id="discount-modal-overlay"
  class="discount-overlay"
  role="dialog"
  aria-modal="true"
  aria-labelledby="discount-title"
  aria-hidden="true"
  style="display: none;"
>
  <div class="discount-dialog" role="document">
    <!-- Cross Close Button -->
    <button
      type="button"
      class="discount-close-btn"
      id="btn-close-discount"
      aria-label="Close limited-time discount offer"
    >
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
        <line x1="18" y1="6" x2="6" y2="18"></line>
        <line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
    </button>

    <!-- Header Badge -->
    <div class="discount-badge-wrap">
      <span class="discount-badge">
        <span class="pulse-dot" aria-hidden="true"></span>
        {popup.badgeText}
      </span>
    </div>

    <!-- Main Content Area -->
    <div class="discount-body">
      <h3 id="discount-title" class="discount-title">
        {popup.headline}
      </h3>
      <p class="discount-sub">
        {popup.subheadline}
      </p>

      <!-- 18-Hour Real-Time Countdown Box -->
      <div class="discount-timer-card">
        <div class="timer-label-row">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="12" cy="12" r="10"></circle>
            <polyline points="12 6 12 12 16 14"></polyline>
          </svg>
          <span>Special Offer Window Closes In:</span>
        </div>
        <div class="countdown-display" aria-label="Countdown timer">
          <div class="time-block">
            <span class="time-num" id="discount-hours">18</span>
            <span class="time-unit">Hours</span>
          </div>
          <span class="time-colon">:</span>
          <div class="time-block">
            <span class="time-num" id="discount-mins">00</span>
            <span class="time-unit">Mins</span>
          </div>
          <span class="time-colon">:</span>
          <div class="time-block">
            <span class="time-num" id="discount-secs">00</span>
            <span class="time-unit">Secs</span>
          </div>
        </div>
      </div>

      <!-- Both Kits Side-by-Side (Stacked on Mobile) -->
      <div class="discount-tiers-grid">
        <!-- STARTER KIT ($15) -->
        <div class="discount-tier-card tier-starter">
          <div class="tier-badge-row">
            <span class="tier-pill tier-pill-neutral">{starter.badge || 'Foundation'}</span>
            <span class="tier-save-tag">45% OFF</span>
          </div>

          <div class="tier-img-wrap">
            <img
              src={starter.image}
              alt="Starter Kit Mockup"
              width="100"
              height="100"
              loading="eager"
              decoding="async"
            />
          </div>

          <div class="tier-info">
            <h4 class="tier-name">{starter.name}</h4>
            <div class="tier-pricing-row">
              <span class="price-old">${starter.originalPrice}</span>
              <span class="price-current">${starter.discountedPrice}</span>
              <span class="price-cur">USD</span>
            </div>
            <p class="tier-pitch">{starter.pitch}</p>
          </div>

          <a
            href={starter.checkoutUrl}
            class="btn-tier-cta btn-starter-cta"
            id="btn-discount-starter"
            data-checkout-tier="starter-discount-45"
            data-checkout-price={starter.discountedPrice}
          >
            {starter.ctaText}
          </a>
        </div>

        <!-- COMPLETE ACTION VAULT ($31) - FEATURED -->
        <div class="discount-tier-card tier-complete featured">
          <div class="tier-badge-row">
            <span class="tier-pill tier-pill-featured">{complete.badge || 'Best Value'}</span>
            <span class="tier-save-tag save-featured">45% OFF</span>
          </div>

          <div class="tier-img-wrap">
            <img
              src={complete.image}
              alt="Complete Action Vault Mockup"
              width="100"
              height="100"
              loading="eager"
              decoding="async"
            />
          </div>

          <div class="tier-info">
            <h4 class="tier-name">{complete.name}</h4>
            <div class="tier-pricing-row">
              <span class="price-old">${complete.originalPrice}</span>
              <span class="price-current highlight">${complete.discountedPrice}</span>
              <span class="price-cur">USD</span>
            </div>
            <p class="tier-pitch">{complete.pitch}</p>
          </div>

          <a
            href={complete.checkoutUrl}
            class="btn-tier-cta btn-complete-cta"
            id="btn-discount-complete"
            data-checkout-tier="complete-discount-45"
            data-checkout-price={complete.discountedPrice}
          >
            {complete.ctaText}
          </a>
        </div>
      </div>

      <!-- Footer Microcopy & Dismissal -->
      <div class="discount-footer">
        <div class="discount-microcopy">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
            <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
          </svg>
          <span>One-time payment • Secure 256-bit checkout • Instant email delivery</span>
        </div>

        <button
          type="button"
          class="discount-decline-link"
          id="btn-decline-discount"
        >
          {popup.declineText}
        </button>
      </div>
    </div>
  </div>
</div>

<style>
  /* Overlay Backdrop */
  .discount-overlay {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 99999;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1rem;
    background-color: rgba(35, 29, 25, 0.75);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    opacity: 0;
    transition: opacity 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .discount-overlay.is-active {
    opacity: 1;
  }

  /* Modal Dialog Card */
  .discount-dialog {
    position: relative;
    width: 100%;
    max-width: 640px;
    background-color: #FFFFFF;
    border: 1px solid var(--border-light, #EBE5DB);
    border-radius: 20px;
    box-shadow: 0 24px 64px rgba(43, 37, 33, 0.3), 0 4px 16px rgba(43, 37, 33, 0.08);
    padding: 2.25rem 2rem 1.75rem;
    transform: scale(0.93) translateY(12px);
    transition: transform 0.32s cubic-bezier(0.16, 1, 0.3, 1);
    max-height: 94vh;
    overflow-y: auto;
    -webkit-overflow-scrolling: touch;
  }

  .discount-overlay.is-active .discount-dialog {
    transform: scale(1) translateY(0);
  }

  /* Cross Close Button */
  .discount-close-btn {
    position: absolute;
    top: 1rem;
    right: 1rem;
    width: 36px;
    height: 36px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background-color: var(--bg-surface-subtle, #F6F3EC);
    color: var(--text-muted, #6E6660);
    border: 1px solid var(--border-light, #EBE5DB);
    border-radius: 50%;
    cursor: pointer;
    transition: all 0.2s ease;
    padding: 0;
    z-index: 2;
  }

  .discount-close-btn:hover,
  .discount-close-btn:focus-visible {
    background-color: var(--terracotta-subtle, #FAEEEA);
    color: var(--terracotta, #C85A3A);
    border-color: var(--terracotta-border, #E8B9AC);
    outline: none;
    transform: rotate(90deg);
  }

  /* Badge */
  .discount-badge-wrap {
    display: flex;
    justify-content: center;
    margin-bottom: 0.85rem;
  }

  .discount-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.35rem 0.85rem;
    background-color: #FEF3F0;
    color: var(--terracotta, #C85A3A);
    border: 1px solid var(--terracotta-border, #E8B9AC);
    border-radius: var(--radius-pill, 9999px);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .pulse-dot {
    width: 8px;
    height: 8px;
    background-color: var(--terracotta, #C85A3A);
    border-radius: 50%;
    animation: pulse 1.8s infinite ease-in-out;
  }

  @keyframes pulse {
    0% { transform: scale(0.9); opacity: 1; box-shadow: 0 0 0 0 rgba(200, 90, 58, 0.7); }
    70% { transform: scale(1.15); opacity: 0.8; box-shadow: 0 0 0 7px rgba(200, 90, 58, 0); }
    100% { transform: scale(0.9); opacity: 1; box-shadow: 0 0 0 0 rgba(200, 90, 58, 0); }
  }

  /* Typography */
  .discount-title {
    font-family: var(--font-serif, "Playfair Display", Georgia, serif);
    font-size: 1.55rem;
    line-height: 1.25;
    color: var(--text-headline, #2B2521);
    text-align: center;
    margin-bottom: 0.4rem;
  }

  .discount-sub {
    font-size: 0.9rem;
    line-height: 1.45;
    color: var(--text-muted, #6E6660);
    text-align: center;
    margin-bottom: 1.1rem;
    max-width: 480px;
    margin-left: auto;
    margin-right: auto;
  }

  /* Countdown Card */
  .discount-timer-card {
    background-color: var(--bg-surface-subtle, #F6F3EC);
    border: 1px solid var(--border-light, #EBE5DB);
    border-radius: 12px;
    padding: 0.75rem 1rem;
    margin-bottom: 1.25rem;
    text-align: center;
  }

  .timer-label-row {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.775rem;
    font-weight: 600;
    color: var(--text-headline, #2B2521);
    margin-bottom: 0.45rem;
  }

  .countdown-display {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
  }

  .time-block {
    display: flex;
    flex-direction: column;
    align-items: center;
    background-color: #FFFFFF;
    border: 1px solid var(--border-medium, #DCD4C7);
    border-radius: 8px;
    padding: 0.3rem 0.6rem;
    min-width: 54px;
    box-shadow: 0 2px 5px rgba(43, 37, 33, 0.04);
  }

  .time-num {
    font-family: var(--font-sans, -apple-system, sans-serif);
    font-size: 1.25rem;
    font-weight: 800;
    color: var(--terracotta, #C85A3A);
    line-height: 1.1;
    font-variant-numeric: tabular-nums;
  }

  .time-unit {
    font-size: 0.625rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--text-light, #948B84);
    font-weight: 600;
    margin-top: 0.15rem;
  }

  .time-colon {
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--text-light, #948B84);
    margin-top: -0.7rem;
  }

  /* Two-Tier Cards Grid */
  .discount-tiers-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    margin-bottom: 1.25rem;
  }

  .discount-tier-card {
    display: flex;
    flex-direction: column;
    background-color: #FFFFFF;
    border: 1.5px solid var(--border-medium, #DCD4C7);
    border-radius: 14px;
    padding: 1.15rem 1rem 1rem;
    position: relative;
    transition: all 0.2s ease;
  }

  .discount-tier-card.featured {
    border-color: var(--terracotta, #C85A3A);
    background-color: #FFFAF8;
    box-shadow: 0 4px 16px rgba(200, 90, 58, 0.1);
  }

  .tier-badge-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 0.75rem;
  }

  .tier-pill {
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    padding: 0.2rem 0.55rem;
    border-radius: var(--radius-pill, 9999px);
  }

  .tier-pill-neutral {
    background-color: var(--bg-surface-subtle, #F6F3EC);
    color: var(--text-muted, #6E6660);
    border: 1px solid var(--border-light, #EBE5DB);
  }

  .tier-pill-featured {
    background-color: var(--terracotta, #C85A3A);
    color: #FFFFFF;
  }

  .tier-save-tag {
    font-size: 0.7rem;
    font-weight: 700;
    color: var(--success-green, #3F704D);
    background-color: var(--success-bg, #EDF5F0);
    padding: 0.2rem 0.45rem;
    border-radius: var(--radius-pill, 9999px);
  }

  .tier-img-wrap {
    width: 64px;
    height: 64px;
    margin: 0 auto 0.75rem;
    border-radius: 8px;
    overflow: hidden;
    background-color: var(--bg-surface-subtle, #F6F3EC);
    box-shadow: 0 2px 6px rgba(43, 37, 33, 0.08);
  }

  .tier-img-wrap img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .tier-info {
    text-align: center;
    flex: 1;
    margin-bottom: 0.85rem;
  }

  .tier-name {
    font-family: var(--font-serif, "Playfair Display", Georgia, serif);
    font-size: 1.1rem;
    color: var(--text-headline, #2B2521);
    margin-bottom: 0.35rem;
    line-height: 1.2;
  }

  .tier-pricing-row {
    display: flex;
    align-items: baseline;
    justify-content: center;
    gap: 0.35rem;
    margin-bottom: 0.5rem;
  }

  .price-old {
    font-size: 0.85rem;
    color: var(--text-light, #948B84);
    text-decoration: line-through;
  }

  .price-current {
    font-size: 1.35rem;
    font-weight: 800;
    color: var(--text-headline, #2B2521);
    line-height: 1;
  }

  .price-current.highlight {
    color: var(--terracotta, #C85A3A);
  }

  .price-cur {
    font-size: 0.7rem;
    font-weight: 600;
    color: var(--text-muted, #6E6660);
  }

  .tier-pitch {
    font-size: 0.76rem;
    color: var(--text-muted, #6E6660);
    line-height: 1.35;
  }

  /* CTAs */
  .btn-tier-cta {
    width: 100%;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.75rem 0.9rem;
    font-size: 0.9rem;
    font-weight: 700;
    text-decoration: none;
    border-radius: var(--radius-pill, 9999px);
    transition: all 0.2s ease;
    border: none;
    cursor: pointer;
    text-align: center;
  }

  .btn-starter-cta {
    background-color: var(--bg-surface-subtle, #F6F3EC);
    color: var(--text-headline, #2B2521);
    border: 1.5px solid var(--border-medium, #DCD4C7);
  }

  .btn-starter-cta:hover {
    background-color: #EFEBE2;
    border-color: var(--text-muted, #6E6660);
    transform: translateY(-1px);
  }

  .btn-complete-cta {
    background-color: var(--terracotta, #C85A3A);
    color: #FFFFFF;
    box-shadow: 0 3px 12px rgba(200, 90, 58, 0.3);
  }

  .btn-complete-cta:hover {
    background-color: var(--terracotta-hover, #B44D2F);
    transform: translateY(-1px);
    box-shadow: 0 5px 16px rgba(200, 90, 58, 0.4);
  }

  /* Footer */
  .discount-footer {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
  }

  .discount-microcopy {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.725rem;
    color: var(--text-light, #948B84);
    text-align: center;
  }

  .discount-decline-link {
    background: none;
    border: none;
    color: var(--text-light, #948B84);
    font-size: 0.775rem;
    text-decoration: underline;
    text-underline-offset: 3px;
    cursor: pointer;
    padding: 0.2rem 0.5rem;
    transition: color 0.15s ease;
  }

  .discount-decline-link:hover {
    color: var(--text-muted, #6E6660);
  }

  /* Mobile responsiveness */
  @media (max-width: 560px) {
    .discount-dialog {
      padding: 1.75rem 1.15rem 1.4rem;
      border-radius: 16px;
    }

    .discount-title {
      font-size: 1.3rem;
    }

    .discount-tiers-grid {
      grid-template-columns: 1fr;
      gap: 0.85rem;
    }

    .discount-tier-card {
      padding: 0.9rem 0.85rem;
    }

    .tier-img-wrap {
      display: none;
    }

    .time-block {
      min-width: 48px;
      padding: 0.25rem 0.45rem;
    }

    .time-num {
      font-size: 1.15rem;
    }
  }
</style>

<script is:inline define:vars={{ delaySec: popup.delaySeconds, countdownHours: popup.countdownHours }}>
  (function () {
    const STORAGE_DISMISSED = 'hfi_discount_popup_dismissed';
    const STORAGE_EXPIRY = 'hfi_discount_countdown_expiry';

    const overlay = document.getElementById('discount-modal-overlay');
    const closeBtn = document.getElementById('btn-close-discount');
    const declineBtn = document.getElementById('btn-decline-discount');
    const starterBtn = document.getElementById('btn-discount-starter');
    const completeBtn = document.getElementById('btn-discount-complete');
    const elHours = document.getElementById('discount-hours');
    const elMins = document.getElementById('discount-mins');
    const elSecs = document.getElementById('discount-secs');

    if (!overlay) return;

    // 1. Check if user already dismissed or claimed in this session
    function isDismissed() {
      try {
        return sessionStorage.getItem(STORAGE_DISMISSED) === 'true';
      } catch (e) {
        return false;
      }
    }

    function markDismissed() {
      try {
        sessionStorage.setItem(STORAGE_DISMISSED, 'true');
      } catch (e) {}
    }

    // 2. Persistent 18-Hour Countdown Timer
    function getOrSetExpiry() {
      try {
        let stored = localStorage.getItem(STORAGE_EXPIRY);
        if (stored) {
          const num = parseInt(stored, 10);
          if (!isNaN(num) && num > Date.now()) {
            return num;
          }
        }
        // Set new 18-hour window from now
        const newExpiry = Date.now() + (countdownHours || 18) * 60 * 60 * 1000;
        localStorage.setItem(STORAGE_EXPIRY, newExpiry.toString());
        return newExpiry;
      } catch (e) {
        return Date.now() + 18 * 60 * 60 * 1000;
      }
    }

    const expiryTime = getOrSetExpiry();

    function updateCountdown() {
      const now = Date.now();
      const diff = Math.max(0, expiryTime - now);

      const hours = Math.floor(diff / (1000 * 60 * 60));
      const mins = Math.floor((diff % (1000 * 60 * 60)) / (1000 * 60));
      const secs = Math.floor((diff % (1000 * 60)) / 1000);

      if (elHours) elHours.textContent = hours.toString().padStart(2, '0');
      if (elMins) elMins.textContent = mins.toString().padStart(2, '0');
      if (elSecs) elSecs.textContent = secs.toString().padStart(2, '0');
    }

    updateCountdown();
    setInterval(updateCountdown, 1000);

    // 3. Open Modal with Animation
    function openModal() {
      if (isDismissed()) return;

      overlay.style.display = 'flex';
      overlay.setAttribute('aria-hidden', 'false');
      // Force reflow for transition
      void overlay.offsetWidth;
      overlay.classList.add('is-active');

      // Track Impression
      if (typeof window.trackFunnelEvent === 'function') {
        window.trackFunnelEvent('DiscountPopupViewed', {
          discount_percent: 45,
          starter_price: 15,
          complete_price: 31,
          currency: 'USD'
        }, true);
      }
    }

    // 4. Close Modal
    function closeModal() {
      overlay.classList.remove('is-active');
      overlay.setAttribute('aria-hidden', 'true');
      markDismissed();
      setTimeout(function () {
        overlay.style.display = 'none';
      }, 320);
    }

    // 5. Event Listeners for Cross & Dismissal
    if (closeBtn) {
      closeBtn.addEventListener('click', closeModal);
    }
    if (declineBtn) {
      declineBtn.addEventListener('click', closeModal);
    }

    // Close on clicking backdrop outside dialog
    overlay.addEventListener('click', function (e) {
      if (e.target === overlay) {
        closeModal();
      }
    });

    // Close on ESC key
    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape' && overlay.classList.contains('is-active')) {
        closeModal();
      }
    });

    // When either CTA is clicked, mark dismissed so it doesn't reopen
    if (starterBtn) {
      starterBtn.addEventListener('click', function () {
        markDismissed();
      });
    }
    if (completeBtn) {
      completeBtn.addEventListener('click', function () {
        markDismissed();
      });
    }

    // 6. Trigger popup 5-6 seconds after page loads (default: 5.5s)
    if (!isDismissed()) {
      const delayMs = Math.max(1000, (delaySec || 5.5) * 1000);
      setTimeout(openModal, delayMs);
    }
  })();
</script>
