---
// Sticky Mobile CTA Bar - Appears smoothly once user scrolls past hero
import { offerConfig } from '../../config/offer';
const { starter } = offerConfig;
---

<aside class="sticky-mobile-bar" id="sticky-mobile-bar" role="complementary" aria-label="Mobile quick checkout access">
  <div class="sticky-inner">
    <div class="sticky-info">
      <span class="sticky-title">Her First Income</span>
      <span class="sticky-meta">From ${starter.price} &bull; Instant Delivery</span>
    </div>
    <a href="#pricing" class="btn-primary sticky-btn" id="sticky-cta-btn">
      {starter.ctaText}
    </a>
  </div>
</aside>

<script is:inline>
  (function () {
    const bar = document.getElementById('sticky-mobile-bar');
    const hero = document.getElementById('hero');
    if (!bar || !hero) return;

    let isVisible = false;

    function handleScroll() {
      const heroRect = hero.getBoundingClientRect();
      // Show sticky bar once bottom of hero is passed
      const shouldShow = heroRect.bottom < 50;

      if (shouldShow !== isVisible) {
        isVisible = shouldShow;
        if (isVisible) {
          bar.classList.add('visible');
        } else {
          bar.classList.remove('visible');
        }
      }
    }

    window.addEventListener('scroll', handleScroll, { passive: true });
    handleScroll();
  })();
</script>

<style>
  .sticky-mobile-bar {
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    z-index: 990;
    background: #FFFFFF;
    border-top: 1px solid var(--border-medium);
    box-shadow: 0 -4px 16px rgba(43, 37, 33, 0.12);
    padding: 0.65rem 1rem;
    transform: translateY(110%);
    transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .sticky-mobile-bar.visible {
    transform: translateY(0);
  }

  /* Only display on mobile/tablet viewports where it is needed */
  @media (min-width: 820px) {
    .sticky-mobile-bar {
      display: none !important;
    }
  }

  .sticky-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    max-width: 520px;
    margin: 0 auto;
  }

  .sticky-info {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .sticky-title {
    font-family: var(--font-serif);
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--text-headline);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .sticky-meta {
    font-size: 0.75rem;
    color: var(--text-muted);
  }

  .sticky-btn {
    flex-shrink: 0;
    width: auto;
    min-height: 48px;
    padding: 0.65rem 1.25rem;
    font-size: 0.925rem;
  }
</style>
