---
// Photorealistic Starter Pack Mockup Graphic
// Responsive: displays 16:9 landscape on desktop/tablets, 1:1 square on mobile
// Completely uncropped to preserve all 6 resources, titles, badges, and category pills.
---

<div class="mockup-container" aria-label="Her First Income Starter Pack mockup showing 6 digital guides and templates">
  <div class="mockup-frame-wrap">
    <picture>
      <!-- Mobile screens: 1:1 square render for maximum vertical readability -->
      <source
        media="(max-width: 640px)"
        srcset="/images/mockups/starter-pack-square.webp"
        type="image/webp"
      />
      <source
        media="(max-width: 640px)"
        srcset="/images/mockups/starter-pack-square.jpg"
        type="image/jpeg"
      />

      <!-- Desktop & Tablets: 16:9 landscape render -->
      <source
        srcset="/images/mockups/starter-pack-landscape.webp"
        type="image/webp"
      />
      <img
        src="/images/mockups/starter-pack-landscape.jpg"
        alt="Her First Income Starter Pack - 6 Valuable Resources including Core Guide, Worksheets, Toolkit, Confidence Reset, Weekly Planner, and First Dollar Action Checklist"
        class="mockup-img"
        width="1024"
        height="576"
        loading="eager"
        fetchpriority="high"
        decoding="async"
      />
    </picture>

    <!-- Floating Trust Badge (Non-obstructing bottom tag) -->
    <div class="floating-badge">
      <div class="badge-icon">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
          <polyline points="14 2 14 8 20 8"></polyline>
          <line x1="16" y1="13" x2="8" y2="13"></line>
          <line x1="16" y1="17" x2="8" y2="17"></line>
          <polyline points="10 9 9 9 8 9"></polyline>
        </svg>
      </div>
      <div>
        <div class="badge-text-main">Instant Digital Access</div>
        <div class="badge-text-sub">Delivered directly to your inbox &bull; Zero waiting</div>
      </div>
    </div>
  </div>
</div>

<style>
  .mockup-container {
    position: relative;
    width: 100%;
    max-width: 580px;
    margin: 0 auto;
    padding: 0.5rem 0 1.5rem;
  }

  .mockup-frame-wrap {
    position: relative;
    display: block;
    width: 100%;
    border-radius: var(--radius-lg, 16px);
    background: #FFFFFF;
    box-shadow: 0 18px 45px -10px rgba(44, 39, 36, 0.16), 0 2px 10px rgba(0, 0, 0, 0.04);
    border: 1px solid var(--border-light);
    overflow: visible;
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }

  .mockup-frame-wrap:hover {
    transform: translateY(-2px);
    box-shadow: 0 22px 50px -10px rgba(44, 39, 36, 0.2), 0 4px 12px rgba(0, 0, 0, 0.05);
  }

  /* Uncropped Image Display */
  .mockup-img {
    display: block;
    width: 100%;
    height: auto;
    max-width: 100%;
    object-fit: contain; /* Guarantee zero cropping */
    border-radius: var(--radius-lg, 16px);
  }

  /* Floating Badge positioned cleanly below */
  .floating-badge {
    position: absolute;
    left: 1.25rem;
    bottom: -1.25rem;
    z-index: 3;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    background: rgba(255, 255, 255, 0.96);
    backdrop-filter: blur(8px);
    border: 1px solid var(--border-light);
    border-radius: var(--radius-md);
    padding: 0.6rem 0.95rem;
    box-shadow: 0 10px 24px rgba(44, 39, 36, 0.12);
  }

  .badge-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border-radius: 8px;
    background: var(--sage-100);
    color: var(--sage-800);
    flex-shrink: 0;
  }

  .badge-text-main {
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--text-headline);
    line-height: 1.2;
  }

  .badge-text-sub {
    font-size: 0.7rem;
    color: var(--text-muted);
    line-height: 1.2;
  }

  @media (max-width: 640px) {
    .mockup-container {
      max-width: 380px;
      padding-bottom: 2rem;
    }
    .floating-badge {
      left: 50%;
      transform: translateX(-50%);
      bottom: -1rem;
      width: calc(100% - 2rem);
      max-width: 320px;
    }
  }
</style>
