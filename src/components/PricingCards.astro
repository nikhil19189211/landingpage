---
// Pricing Cards Component (Reusable across Landing Page & Final CTA)
import { offerConfig, TierConfig } from '../../config/offer';
import WalletIcons from './WalletIcons.astro';

interface Props {
  compact?: boolean;
}

const { compact = false } = Astro.props;
const { starter, complete, tierOrderMobile, valueDisclaimer } = offerConfig;

const isCompleteFirst = tierOrderMobile === 'complete-first';
---

<section class={`pricing-section ${compact ? 'pricing-compact' : 'section'}`} id="pricing">
  <div class="container">
    {!compact && (
      <div class="section-header">
        <span class="section-label">Transparent Pricing</span>
        <h2>Choose Your Level of Support</h2>
        <p>
          One-time payment. Instant email delivery. No subscriptions or hidden upgrades required.
        </p>
      </div>
    )}

    <div class={`pricing-cards-container ${isCompleteFirst ? 'order-complete-mobile-first' : ''}`}>
      <!-- COMPLETE CARD ($47) -->
      <div class="pricing-card complete-card" id="card-complete">
        <div class="card-badge-header">
          <span class="badge-best-value">{complete.badge || 'Best Value'}</span>
          <span class="badge-savings">Save 64% by Value</span>
        </div>

        <div class="card-head">
          <h3 class="tier-name">{complete.name}</h3>
          <p class="tier-pitch">{complete.shortPitch}</p>

          <div class="price-container">
            <div class="price-row">
              <span class="price-currency">$</span>
              <span class="price-amount">{complete.price}</span>
              <span class="price-period">USD &bull; One-time</span>
            </div>
            <div class="value-comparison">
              <span class="value-label">Estimated value:</span>
              <span class="value-strikethrough">${complete.estimatedValue}</span>
            </div>
          </div>
        </div>

        <!-- CTA Button -->
        <div class="card-cta-wrap">
          <a
            href={complete.checkoutUrl}
            class="btn-primary"
            data-checkout-tier="complete"
            data-checkout-price={complete.price}
            id="btn-checkout-complete"
          >
            {complete.ctaText}
          </a>

          <div class="card-payments">
            <WalletIcons />
            <div class="microcopy-secure">
              <span class="microcopy-item">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                  <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                </svg>
                Secure 256-Bit Checkout
              </span>
              <span>&bull;</span>
              <span class="microcopy-item">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
                  <polyline points="22,6 12,13 2,6"></polyline>
                </svg>
                Instant Email Delivery
              </span>
            </div>
          </div>
        </div>

        <!-- Item Breakdown -->
        <div class="card-items-section">
          <div class="items-heading">Included in Complete Kit:</div>
          <ul class="tier-item-list" role="list">
            {complete.items.map((item) => (
              <li class="tier-item">
                <div class="item-check">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                    <polyline points="20 6 9 17 4 12"></polyline>
                  </svg>
                </div>
                <div class="item-details">
                  <div class="item-title-row">
                    <span class="item-title">{item.title}</span>
                    <span class="item-val">Est. ${item.estimatedValue}</span>
                  </div>
                  {!compact && <p class="item-desc">{item.description}</p>}
                </div>
              </li>
            ))}
          </ul>
        </div>
      </div>

      <!-- STARTER CARD ($17) -->
      <div class="pricing-card starter-card" id="card-starter">
        <div class="card-badge-header">
          <span class="badge-starter">Foundation Level</span>
        </div>

        <div class="card-head">
          <h3 class="tier-name">{starter.name}</h3>
          <p class="tier-pitch">{starter.shortPitch}</p>

          <div class="price-container">
            <div class="price-row">
              <span class="price-currency">$</span>
              <span class="price-amount">{starter.price}</span>
              <span class="price-period">USD &bull; One-time</span>
            </div>
            <div class="value-comparison">
              <span class="value-label">Estimated value:</span>
              <span class="value-strikethrough">${starter.estimatedValue}</span>
            </div>
          </div>
        </div>

        <!-- CTA Button -->
        <div class="card-cta-wrap">
          <a
            href={starter.checkoutUrl}
            class="btn-primary"
            data-checkout-tier="starter"
            data-checkout-price={starter.price}
            id="btn-checkout-starter"
          >
            {starter.ctaText}
          </a>

          <div class="card-payments">
            <WalletIcons />
            <div class="microcopy-secure">
              <span class="microcopy-item">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                  <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                </svg>
                Secure 256-Bit Checkout
              </span>
              <span>&bull;</span>
              <span class="microcopy-item">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
                  <polyline points="22,6 12,13 2,6"></polyline>
                </svg>
                Instant Email Delivery
              </span>
            </div>
          </div>
        </div>

        <!-- Item Breakdown -->
        <div class="card-items-section">
          <div class="items-heading">Included in Starter Kit:</div>
          <ul class="tier-item-list" role="list">
            {starter.items.map((item) => (
              <li class="tier-item">
                <div class="item-check">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                    <polyline points="20 6 9 17 4 12"></polyline>
                  </svg>
                </div>
                <div class="item-details">
                  <div class="item-title-row">
                    <span class="item-title">{item.title}</span>
                    <span class="item-val">Est. ${item.estimatedValue}</span>
                  </div>
                  {!compact && <p class="item-desc">{item.description}</p>}
                </div>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>

    <!-- Honest Value Calculation Footnote -->
    <div class="pricing-disclaimer">
      <p>* {valueDisclaimer}</p>
    </div>
  </div>
</section>

<style>
  .pricing-section {
    background-color: var(--bg-surface-subtle);
    border-bottom: 1px solid var(--border-light);
  }

  .pricing-compact {
    padding-top: 1rem;
    padding-bottom: 1rem;
    background: transparent;
    border: none;
  }

  .pricing-cards-container {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
    max-width: 980px;
    margin: 0 auto;
  }

  /* On desktop: Starter left, Complete right */
  @media (min-width: 820px) {
    .pricing-cards-container {
      grid-template-columns: 1fr 1fr;
      align-items: stretch;
    }
    /* If complete-first is configured, keep Complete on right for desktop reading, or switchable */
    .order-complete-mobile-first #card-starter {
      order: 1;
    }
    .order-complete-mobile-first #card-complete {
      order: 2;
    }
  }

  /* On mobile: If complete-first is enabled, Complete renders FIRST */
  @media (max-width: 819px) {
    .order-complete-mobile-first #card-complete {
      order: -1;
    }
    .order-complete-mobile-first #card-starter {
      order: 1;
    }
  }

  .pricing-card {
    background: #FFFFFF;
    border: 1px solid var(--border-medium);
    border-radius: var(--radius-lg);
    padding: 2rem 1.5rem;
    box-shadow: var(--shadow-card);
    display: flex;
    flex-direction: column;
    position: relative;
    height: 100%;
  }

  @media (min-width: 640px) {
    .pricing-card {
      padding: 2.5rem 2rem;
    }
  }

  /* Complete Card Highlight */
  .complete-card {
    border: 2px solid var(--sage-700);
    box-shadow: 0 8px 28px rgba(75, 94, 78, 0.12);
  }

  .card-badge-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1.25rem;
  }

  .badge-starter {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--text-muted);
    background: var(--bg-surface-subtle);
    padding: 0.3rem 0.65rem;
    border-radius: var(--radius-pill);
    border: 1px solid var(--border-medium);
  }

  .badge-savings {
    font-size: 0.775rem;
    font-weight: 600;
    color: var(--sage-800);
    background: var(--sage-100);
    padding: 0.25rem 0.6rem;
    border-radius: var(--radius-pill);
  }

  .tier-name {
    font-size: 1.75rem;
    color: var(--text-headline);
    margin-bottom: 0.5rem;
  }

  .tier-pitch {
    font-size: 0.95rem;
    color: var(--text-muted);
    line-height: 1.5;
    margin-bottom: 1.5rem;
    min-height: 3em;
  }

  .price-container {
    background: var(--bg-surface-subtle);
    border: 1px solid var(--border-light);
    border-radius: var(--radius-md);
    padding: 1rem 1.25rem;
    margin-bottom: 1.5rem;
  }

  .price-row {
    display: flex;
    align-items: baseline;
    gap: 0.35rem;
  }

  .price-currency {
    font-size: 1.5rem;
    font-weight: 600;
    color: var(--text-headline);
  }

  .price-amount {
    font-family: var(--font-serif);
    font-size: 3rem;
    font-weight: 700;
    line-height: 1;
    color: var(--text-headline);
  }

  .price-period {
    font-size: 0.85rem;
    color: var(--text-muted);
    font-weight: 500;
    margin-left: 0.25rem;
  }

  .value-comparison {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.85rem;
    color: var(--text-muted);
    margin-top: 0.4rem;
  }

  .value-strikethrough {
    text-decoration: line-through;
    color: var(--text-light);
    font-weight: 600;
  }

  .card-cta-wrap {
    margin-bottom: 2rem;
  }

  .card-payments {
    margin-top: 0.85rem;
    text-align: center;
  }

  .card-items-section {
    border-top: 1px solid var(--border-light);
    padding-top: 1.5rem;
    flex-grow: 1;
    display: flex;
    flex-direction: column;
  }

  .items-heading {
    font-size: 0.85rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--sage-800);
    margin-bottom: 1.15rem;
  }

  .tier-item-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
  }

  .tier-item {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
  }

  .item-check {
    flex-shrink: 0;
    width: 22px;
    height: 22px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--sage-100);
    color: var(--sage-800);
    border-radius: 50%;
    margin-top: 2px;
  }

  .item-details {
    flex: 1;
  }

  .item-title-row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 0.5rem;
  }

  .item-title {
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--text-headline);
    line-height: 1.4;
  }

  .item-val {
    font-size: 0.8rem;
    color: var(--text-muted);
    flex-shrink: 0;
    background: var(--bg-surface-subtle);
    padding: 0.1rem 0.4rem;
    border-radius: var(--radius-sm);
  }

  .item-desc {
    font-size: 0.835rem;
    color: var(--text-muted);
    line-height: 1.45;
    margin-top: 0.3rem;
    margin-bottom: 0;
  }

  .pricing-disclaimer {
    text-align: center;
    font-size: 0.8rem;
    color: var(--text-light);
    margin-top: 2rem;
  }
</style>
