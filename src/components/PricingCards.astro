---
// Pricing Cards Component (Reusable across Landing Page & Final CTA)
import { offerConfig, TierConfig } from '../../config/offer';
import WalletIcons from './WalletIcons.astro';

interface Props {
  compact?: boolean;
}

const { compact = false } = Astro.props;
const { starter, complete, tierOrderMobile, valueDisclaimer } = offerConfig;

const isCompleteFirst = tierOrderMobile === 'complete-first';
---

<section class={`pricing-section ${compact ? 'pricing-compact' : 'section'}`} id="pricing">
  <div class="container">
    {!compact && (
      <div class="section-header">
        <span class="section-label">Transparent Pricing</span>
        <h2>Choose Your Level of Support</h2>
        <p>
          One-time payment. Instant email delivery. No subscriptions or hidden upgrades required.
        </p>
      </div>
    )}

    <!-- Mobile Segmented Tier Switcher -->
    <div class="pricing-mobile-switcher mobile-only" role="tablist" aria-label="Select pricing tier">
      <button
        type="button"
        class="switcher-tab active"
        role="tab"
        aria-selected="true"
        data-target-tier="complete"
      >
        <span class="tab-label">Complete</span>
        <span class="tab-price">${complete.price}</span>
        <span class="tab-badge">Best Value</span>
      </button>
      <button
        type="button"
        class="switcher-tab"
        role="tab"
        aria-selected="false"
        data-target-tier="starter"
      >
        <span class="tab-label">Starter</span>
        <span class="tab-price">${starter.price}</span>
      </button>
    </div>

    <div class="pricing-mobile-hint mobile-only">
      <span>Swipe card or tap tabs above to switch</span>
    </div>

    <div class={`pricing-cards-container ${isCompleteFirst ? 'order-complete-mobile-first' : ''}`}>
      <!-- COMPLETE CARD ($57) -->
      <div class="pricing-card complete-card" id="card-complete">
        <div class="card-badge-header">
          <span class="card-tier-step mobile-only">Card 1 of 2</span>
          <span class="badge-best-value">{complete.badge || 'Best Value'}</span>
          <span class="badge-savings">Save 79% by Value</span>
        </div>

        <div class="card-head">
          <h3 class="tier-name">{complete.name}</h3>
          <p class="tier-pitch">{complete.shortPitch}</p>

          <div class="price-container">
            <div class="price-row">
              <span class="price-currency">$</span>
              <span class="price-amount">{complete.price}</span>
              <span class="price-period">USD &bull; One-time</span>
            </div>
            <div class="value-comparison">
              <span class="value-label">Estimated value:</span>
              <span class="value-strikethrough">${complete.estimatedValue}</span>
            </div>
          </div>
        </div>

        <!-- Uncropped Visual Preview -->
        <div class="pricing-card-preview">
          <img
            src="/images/mockups/action-vault-square.webp"
            alt="Action Vault Complete Resource Kit - 5 Additional Premium Resources"
            class="tier-preview-img"
            width="1024"
            height="1024"
            loading="lazy"
            decoding="async"
          />
        </div>

        <!-- CTA Button -->
        <div class="card-cta-wrap">
          <a
            href={complete.checkoutUrl}
            class="btn-primary"
            data-checkout-tier="complete"
            data-checkout-price={complete.price}
            id="btn-checkout-complete"
          >
            {complete.ctaText}
          </a>

          <div class="card-payments">
            <WalletIcons />
            <div class="microcopy-secure">
              <span class="microcopy-item">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                  <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                </svg>
                Secure 256-Bit Checkout
              </span>
              <span>&bull;</span>
              <span class="microcopy-item">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
                  <polyline points="22,6 12,13 2,6"></polyline>
                </svg>
                Instant Email Delivery
              </span>
            </div>
          </div>
        </div>

        <!-- Item Breakdown -->
        <div class="card-items-section">
          <div class="items-heading">Included in Complete Kit:</div>
          <ul class="tier-item-list" role="list">
            {complete.items.map((item) => (
              <li class="tier-item">
                <div class="item-check">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                    <polyline points="20 6 9 17 4 12"></polyline>
                  </svg>
                </div>
                <div class="item-details">
                  <div class="item-title-row">
                    <span class="item-title">{item.title}</span>
                    <span class="item-val">Est. ${item.estimatedValue}</span>
                  </div>
                  {!compact && <p class="item-desc">{item.description}</p>}
                </div>
              </li>
            ))}
          </ul>
        </div>

        <!-- Mobile Switch Helper -->
        <div class="card-switch-helper mobile-only">
          <button type="button" class="btn-switch-inline" data-switch-to="starter">
            Prefer the Starter Kit ($27)? Tap to switch &rarr;
          </button>
        </div>
      </div>

      <!-- STARTER CARD ($27) -->
      <div class="pricing-card starter-card" id="card-starter">
        <div class="card-badge-header">
          <span class="card-tier-step mobile-only">Card 2 of 2</span>
          <span class="badge-starter">Foundation Level</span>
        </div>

        <div class="card-head">
          <h3 class="tier-name">{starter.name}</h3>
          <p class="tier-pitch">{starter.shortPitch}</p>

          <div class="price-container">
            <div class="price-row">
              <span class="price-currency">$</span>
              <span class="price-amount">{starter.price}</span>
              <span class="price-period">USD &bull; One-time</span>
            </div>
            <div class="value-comparison">
              <span class="value-label">Estimated value:</span>
              <span class="value-strikethrough">${starter.estimatedValue}</span>
            </div>
          </div>
        </div>

        <!-- Uncropped Visual Preview -->
        <div class="pricing-card-preview">
          <img
            src="/images/mockups/starter-pack-square.webp"
            alt="Starter Pack Resource Kit - 6 Valuable Resources"
            class="tier-preview-img"
            width="1024"
            height="1024"
            loading="lazy"
            decoding="async"
          />
        </div>

        <!-- CTA Button -->
        <div class="card-cta-wrap">
          <a
            href={starter.checkoutUrl}
            class="btn-primary"
            data-checkout-tier="starter"
            data-checkout-price={starter.price}
            id="btn-checkout-starter"
          >
            {starter.ctaText}
          </a>

          <div class="card-payments">
            <WalletIcons />
            <div class="microcopy-secure">
              <span class="microcopy-item">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                  <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                </svg>
                Secure 256-Bit Checkout
              </span>
              <span>&bull;</span>
              <span class="microcopy-item">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
                  <polyline points="22,6 12,13 2,6"></polyline>
                </svg>
                Instant Email Delivery
              </span>
            </div>
          </div>
        </div>

        <!-- Item Breakdown -->
        <div class="card-items-section">
          <div class="items-heading">Included in Starter Kit:</div>
          <ul class="tier-item-list" role="list">
            {starter.items.map((item) => (
              <li class="tier-item">
                <div class="item-check">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                    <polyline points="20 6 9 17 4 12"></polyline>
                  </svg>
                </div>
                <div class="item-details">
                  <div class="item-title-row">
                    <span class="item-title">{item.title}</span>
                    <span class="item-val">Est. ${item.estimatedValue}</span>
                  </div>
                  {!compact && <p class="item-desc">{item.description}</p>}
                </div>
              </li>
            ))}
          </ul>
        </div>

        <!-- Mobile Switch Helper -->
        <div class="card-switch-helper mobile-only">
          <button type="button" class="btn-switch-inline" data-switch-to="complete">
            Want the Complete Kit ($57)? Tap to switch &rarr;
          </button>
        </div>
      </div>
    </div>

    <!-- Honest Value Calculation Footnote -->
    <div class="pricing-disclaimer">
      <p>* {valueDisclaimer}</p>
    </div>
  </div>
</section>

<style>
  .pricing-section {
    background-color: var(--bg-surface-subtle);
    border-bottom: 1px solid var(--border-light);
  }

  .pricing-compact {
    padding-top: 1rem;
    padding-bottom: 1rem;
    background: transparent;
    border: none;
  }

  .pricing-cards-container {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
    max-width: 980px;
    margin: 0 auto;
  }

  /* Mobile Segmented Switcher */
  .pricing-mobile-switcher {
    display: none;
    background: #EBE7DF;
    padding: 0.35rem;
    border-radius: var(--radius-pill);
    gap: 0.35rem;
    max-width: 340px;
    margin: 0 auto 1.5rem;
    box-shadow: inset 0 1px 3px rgba(0, 0, 0, 0.06);
  }

  .switcher-tab {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    padding: 0.65rem 0.75rem;
    border-radius: var(--radius-pill);
    border: none;
    background: transparent;
    cursor: pointer;
    font-family: inherit;
    transition: all 0.2s ease;
    color: var(--text-muted);
  }

  .switcher-tab.active {
    background: #FFFFFF;
    color: var(--text-headline);
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
  }

  .tab-label {
    font-size: 0.85rem;
    font-weight: 700;
  }

  .tab-price {
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--text-headline);
  }

  .tab-badge {
    font-size: 0.6rem;
    font-weight: 700;
    text-transform: uppercase;
    background: var(--sage-100);
    color: var(--sage-900);
    padding: 0.15rem 0.4rem;
    border-radius: var(--radius-pill);
    letter-spacing: 0.03em;
  }

  /* On desktop: Starter left, Complete right */
  @media (min-width: 820px) {
    .pricing-cards-container {
      grid-template-columns: 1fr 1fr;
      align-items: stretch;
    }
    .order-complete-mobile-first #card-starter {
      order: 1;
    }
    .order-complete-mobile-first #card-complete {
      order: 2;
    }
    .card-switch-helper {
      display: none !important;
    }
  }

  /* On mobile: Tab toggle switches between Complete & Starter */
  @media (max-width: 819px) {
    .pricing-mobile-switcher {
      display: flex;
    }

    .pricing-cards-container {
      gap: 1.25rem;
    }

    /* By default: Show Complete, Hide Starter */
    .pricing-cards-container:not(.mobile-show-starter) .starter-card {
      display: none !important;
    }
    .pricing-cards-container:not(.mobile-show-starter) .complete-card {
      display: flex !important;
    }

    /* When Starter tab is active: Show Starter, Hide Complete */
    .pricing-cards-container.mobile-show-starter .complete-card {
      display: none !important;
    }
    .pricing-cards-container.mobile-show-starter .starter-card {
      display: flex !important;
    }

    .pricing-card {
      padding: 1.5rem 1.25rem;
    }

    .tier-pitch {
      min-height: auto;
      margin-bottom: 1rem;
    }

    .card-cta-wrap {
      margin-bottom: 1.25rem;
    }

    .tier-item-list {
      gap: 0.85rem;
    }

    .item-desc {
      font-size: 0.8rem;
      line-height: 1.4;
      margin-top: 0.2rem;
    }

    .card-switch-helper {
      margin-top: 1.5rem;
      text-align: center;
      padding-top: 1rem;
      border-top: 1px dashed var(--border-medium);
    }

    .pricing-mobile-hint {
      display: block;
      text-align: center;
      font-size: 0.75rem;
      color: var(--text-light);
      margin-top: -0.75rem;
      margin-bottom: 1.25rem;
    }

    .card-tier-step {
      display: inline-block;
      font-size: 0.7rem;
      font-weight: 700;
      color: var(--text-muted);
      background: var(--bg-surface-subtle);
      padding: 0.2rem 0.5rem;
      border-radius: var(--radius-pill);
      border: 1px solid var(--border-light);
    }

    .btn-switch-inline {
      background: none;
      border: none;
      color: var(--sage-800);
      font-size: 0.85rem;
      font-weight: 600;
      cursor: pointer;
      text-decoration: underline;
      padding: 0.25rem 0.5rem;
      font-family: inherit;
    }
  }

  .pricing-mobile-hint,
  .card-tier-step {
    display: none;
  }

  .pricing-card {
    background: #FFFFFF;
    border: 1px solid var(--border-medium);
    border-radius: var(--radius-lg);
    padding: 2rem 1.5rem;
    box-shadow: var(--shadow-card);
    display: flex;
    flex-direction: column;
    position: relative;
    height: 100%;
  }

  @media (min-width: 640px) {
    .pricing-card {
      padding: 2.5rem 2rem;
    }
  }

  /* Complete Card Highlight */
  .complete-card {
    border: 2px solid var(--sage-700);
    box-shadow: 0 8px 28px rgba(75, 94, 78, 0.12);
  }

  .card-badge-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1.25rem;
  }

  .badge-starter {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--text-muted);
    background: var(--bg-surface-subtle);
    padding: 0.3rem 0.65rem;
    border-radius: var(--radius-pill);
    border: 1px solid var(--border-medium);
  }

  .badge-savings {
    font-size: 0.775rem;
    font-weight: 600;
    color: var(--sage-800);
    background: var(--sage-100);
    padding: 0.25rem 0.6rem;
    border-radius: var(--radius-pill);
  }

  .tier-name {
    font-size: 1.75rem;
    color: var(--text-headline);
    margin-bottom: 0.5rem;
  }

  .tier-pitch {
    font-size: 0.95rem;
    color: var(--text-muted);
    line-height: 1.5;
    margin-bottom: 1.5rem;
    min-height: 3em;
  }

  .price-container {
    background: var(--bg-surface-subtle);
    border: 1px solid var(--border-light);
    border-radius: var(--radius-md);
    padding: 1rem 1.25rem;
    margin-bottom: 1.25rem;
  }

  /* Uncropped Mockup Image inside Pricing Card */
  .pricing-card-preview {
    margin: 0 0 1.5rem;
    border-radius: var(--radius-md);
    border: 1px solid var(--border-light);
    background: #FFFFFF;
    overflow: hidden;
    box-shadow: 0 4px 14px rgba(44, 39, 36, 0.06);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .pricing-card-preview:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 20px rgba(44, 39, 36, 0.1);
  }

  .tier-preview-img {
    display: block;
    width: 100%;
    height: auto;
    max-width: 100%;
    object-fit: contain; /* Guarantees zero cropping */
  }

  .price-row {
    display: flex;
    align-items: baseline;
    gap: 0.35rem;
  }

  .price-currency {
    font-size: 1.5rem;
    font-weight: 600;
    color: var(--text-headline);
  }

  .price-amount {
    font-family: var(--font-serif);
    font-size: 3rem;
    font-weight: 700;
    line-height: 1;
    color: var(--text-headline);
  }

  .price-period {
    font-size: 0.85rem;
    color: var(--text-muted);
    font-weight: 500;
    margin-left: 0.25rem;
  }

  .value-comparison {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.85rem;
    color: var(--text-muted);
    margin-top: 0.4rem;
  }

  .value-strikethrough {
    text-decoration: line-through;
    color: var(--text-light);
    font-weight: 600;
  }

  .card-cta-wrap {
    margin-bottom: 2rem;
  }

  .card-payments {
    margin-top: 0.85rem;
    text-align: center;
  }

  .card-items-section {
    border-top: 1px solid var(--border-light);
    padding-top: 1.5rem;
    flex-grow: 1;
    display: flex;
    flex-direction: column;
  }

  .items-heading {
    font-size: 0.85rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--sage-800);
    margin-bottom: 1.15rem;
  }

  .tier-item-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
  }

  .tier-item {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
  }

  .item-check {
    flex-shrink: 0;
    width: 22px;
    height: 22px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--sage-100);
    color: var(--sage-800);
    border-radius: 50%;
    margin-top: 2px;
  }

  .item-details {
    flex: 1;
  }

  .item-title-row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 0.5rem;
  }

  .item-title {
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--text-headline);
    line-height: 1.4;
  }

  .item-val {
    font-size: 0.8rem;
    color: var(--text-muted);
    flex-shrink: 0;
    background: var(--bg-surface-subtle);
    padding: 0.1rem 0.4rem;
    border-radius: var(--radius-sm);
  }

  .item-desc {
    font-size: 0.835rem;
    color: var(--text-muted);
    line-height: 1.45;
    margin-top: 0.3rem;
    margin-bottom: 0;
  }

  .pricing-disclaimer {
    text-align: center;
    font-size: 0.8rem;
    color: var(--text-light);
    margin-top: 2rem;
  }
</style>

<script is:inline>
  function initPricingSwitchers() {
    var sections = document.querySelectorAll('.pricing-section, .pricing-compact');
    sections.forEach(function (sec) {
      var container = sec.querySelector('.pricing-cards-container');
      var switcher = sec.querySelector('.pricing-mobile-switcher');
      if (!container || !switcher) return;

      var tabs = switcher.querySelectorAll('.switcher-tab');
      var switchBtns = sec.querySelectorAll('.btn-switch-inline');

      function setTier(tier) {
        tabs.forEach(function (tab) {
          var isMatch = tab.getAttribute('data-target-tier') === tier;
          tab.classList.toggle('active', isMatch);
          tab.setAttribute('aria-selected', isMatch ? 'true' : 'false');
        });

        if (tier === 'starter') {
          container.classList.add('mobile-show-starter');
        } else {
          container.classList.remove('mobile-show-starter');
        }
      }

      tabs.forEach(function (tab) {
        tab.addEventListener('click', function () {
          var targetTier = tab.getAttribute('data-target-tier') || 'complete';
          setTier(targetTier);
        });
      });

      switchBtns.forEach(function (btn) {
        btn.addEventListener('click', function () {
          var targetTier = btn.getAttribute('data-switch-to') || 'complete';
          setTier(targetTier);
          // Smooth scroll to card top on mobile switch
          var targetCard = sec.querySelector(targetTier === 'starter' ? '.starter-card' : '.complete-card');
          if (targetCard) {
            targetCard.scrollIntoView({ behavior: 'smooth', block: 'start' });
          }
        });
      });

      // Mobile Touch Swipe Gesture Support
      var touchStartX = 0;
      var touchStartY = 0;
      container.addEventListener('touchstart', function (e) {
        if (!e.changedTouches || e.changedTouches.length === 0) return;
        touchStartX = e.changedTouches[0].clientX;
        touchStartY = e.changedTouches[0].clientY;
      }, { passive: true });

      container.addEventListener('touchend', function (e) {
        if (!e.changedTouches || e.changedTouches.length === 0) return;
        var diffX = e.changedTouches[0].clientX - touchStartX;
        var diffY = e.changedTouches[0].clientY - touchStartY;
        // Horizontal swipe threshold
        if (Math.abs(diffX) > 45 && Math.abs(diffX) > Math.abs(diffY)) {
          if (diffX < 0) {
            // Swiped left -> switch to starter
            setTier('starter');
          } else {
            // Swiped right -> switch to complete
            setTier('complete');
          }
        }
      }, { passive: true });
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initPricingSwitchers);
  } else {
    initPricingSwitchers();
  }
</script>
