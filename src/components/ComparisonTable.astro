---
// Comprehensive Comparison Table & Mobile Stacked Accordion
import { offerConfig, STARTER_ITEMS, COMPLETE_EXCLUSIVE_ITEMS } from '../../config/offer';

const allItems = [
  ...STARTER_ITEMS.map(i => ({ ...i, inStarter: true, inComplete: true })),
  ...COMPLETE_EXCLUSIVE_ITEMS.map(i => ({ ...i, inStarter: false, inComplete: true }))
];

const starterVal = offerConfig.starter.estimatedValue; // $120
const starterPrice = offerConfig.starter.price; // $27
const completeVal = offerConfig.complete.estimatedValue; // $275
const completePrice = offerConfig.complete.price; // $57
---

<section class="section section-comparison" id="comparison">
  <div class="container">
    <div class="section-header">
      <span class="section-label">Side-by-Side Breakdown</span>
      <h2>Compare Starter vs Complete</h2>
      <p>
        Every single guide, checklist, template, and resource laid out transparently.
      </p>
    </div>

    <!-- Desktop Table View (Hidden on mobile) -->
    <div class="comparison-table-wrapper desktop-only">
      <table class="comparison-table" aria-label="Feature comparison between Starter and Complete">
        <thead>
          <tr>
            <th class="col-item" scope="col">Included Resource</th>
            <th class="col-val" scope="col">Est. Value</th>
            <th class="col-tier tier-starter" scope="col">
              <span class="th-tier-name">Starter</span>
              <span class="th-tier-price">${starterPrice}</span>
            </th>
            <th class="col-tier tier-complete" scope="col">
              <span class="th-badge">Best Value</span>
              <span class="th-tier-name">Complete</span>
              <span class="th-tier-price">${completePrice}</span>
            </th>
          </tr>
        </thead>
        <tbody>
          {allItems.map((item, idx) => (
            <tr class={idx % 2 === 0 ? 'row-even' : 'row-odd'}>
              <td class="cell-title">
                <strong>{item.title}</strong>
                {item.subtitle && <span class="cell-subtitle"> {item.subtitle}</span>}
                <div class="cell-meta">
                  {item.pages && <span>{item.pages} pages</span>}
                  {item.templatesCount && <span>{item.templatesCount} templates</span>}
                  {item.videosCount && <span>{item.videosCount} curated videos</span>}
                  {item.promptsCount && <span>{item.promptsCount}+ prompts</span>}
                </div>
              </td>
              <td class="cell-val">${item.estimatedValue}</td>
              <td class="cell-mark">
                {item.inStarter ? (
                  <span class="check-mark" aria-label="Included in Starter">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                      <polyline points="20 6 9 17 4 12"></polyline>
                    </svg>
                  </span>
                ) : (
                  <span class="dash-mark" aria-label="Not included">&mdash;</span>
                )}
              </td>
              <td class="cell-mark cell-complete-col">
                <span class="check-mark check-complete" aria-label="Included in Complete">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                    <polyline points="20 6 9 17 4 12"></polyline>
                  </svg>
                </span>
              </td>
            </tr>
          ))}
        </tbody>
        <tfoot>
          <!-- Totals Row -->
          <tr class="row-totals">
            <td class="cell-title"><strong>Total Estimated Value</strong></td>
            <td class="cell-val"></td>
            <td class="cell-mark">
              <div class="total-box">
                <span class="total-val">${starterVal}</span>
                <span class="total-price">Your price: ${starterPrice}</span>
                <span class="total-save">Save ${starterVal - starterPrice} (74%)</span>
              </div>
            </td>
            <td class="cell-mark cell-complete-col">
              <div class="total-box total-complete-box">
                <span class="total-val">${completeVal}</span>
                <span class="total-price">Your price: ${completePrice}</span>
                <span class="total-save save-complete">Save ${completeVal - completePrice} (64%)</span>
              </div>
            </td>
          </tr>
        </tfoot>
      </table>
    </div>

    <!-- Mobile Responsive Side-by-Side Matrix Table -->
    <div class="comparison-mobile-matrix mobile-only">
      <div class="mobile-matrix-card">
        <!-- Matrix Header -->
        <div class="matrix-header-row">
          <div class="m-col-resource">
            <span class="m-header-label">Resource</span>
          </div>
          <div class="m-col-tier m-col-starter">
            <span class="m-tier-title">Starter</span>
            <span class="m-tier-price">${starterPrice}</span>
          </div>
          <div class="m-col-tier m-col-complete">
            <span class="m-tier-badge">Best Value</span>
            <span class="m-tier-title">Complete</span>
            <span class="m-tier-price">${completePrice}</span>
          </div>
        </div>

        <!-- Matrix Rows -->
        <div class="matrix-body">
          {allItems.map((item, idx) => (
            <div class={`matrix-row ${idx % 2 === 0 ? 'matrix-row-even' : 'matrix-row-odd'}`}>
              <div class="m-col-resource">
                <span class="m-res-name">{item.title}</span>
                <span class="m-res-val">Est. ${item.estimatedValue}</span>
              </div>
              <div class="m-col-tier m-col-starter">
                {item.inStarter ? (
                  <span class="m-check-icon check-starter" aria-label="Included in Starter">
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                      <polyline points="20 6 9 17 4 12"></polyline>
                    </svg>
                  </span>
                ) : (
                  <span class="m-dash" aria-label="Not included">&mdash;</span>
                )}
              </div>
              <div class="m-col-tier m-col-complete highlight-col">
                <span class="m-check-icon check-complete" aria-label="Included in Complete">
                  <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                    <polyline points="20 6 9 17 4 12"></polyline>
                  </svg>
                </span>
              </div>
            </div>
          ))}
        </div>

        <!-- Matrix Totals Footer -->
        <div class="matrix-footer-row">
          <div class="m-col-resource">
            <span class="m-footer-title">Total Value</span>
            <span class="m-footer-sub">One-time</span>
          </div>
          <div class="m-col-tier m-col-starter">
            <span class="m-footer-val">${starterVal}</span>
            <span class="m-footer-price">${starterPrice}</span>
          </div>
          <div class="m-col-tier m-col-complete highlight-col">
            <span class="m-footer-val">${completeVal}</span>
            <span class="m-footer-price">${completePrice}</span>
            <span class="m-footer-save">Save 64%</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Required Summary Sentence Below Comparison Table -->
    <div class="comparison-summary-sentence">
      <p>
        Starter helps you choose and get set up. Complete adds the step-by-step instructions, a 30-day plan, templates, videos and AI prompts to follow through.
      </p>
    </div>
  </div>
</section>

<style>
  .section-comparison {
    background-color: var(--bg-page);
    border-bottom: 1px solid var(--border-light);
  }

  /* Desktop Table Styling */
  .comparison-table-wrapper {
    background: #FFFFFF;
    border: 1px solid var(--border-medium);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-card);
    overflow: hidden;
  }

  .comparison-table {
    width: 100%;
    border-collapse: collapse;
    text-align: left;
  }

  .comparison-table th {
    padding: 1.25rem 1rem;
    background: var(--bg-surface-subtle);
    border-bottom: 2px solid var(--border-medium);
    font-size: 0.95rem;
    color: var(--text-headline);
  }

  .col-item {
    width: 50%;
  }

  .col-val {
    width: 12%;
    text-align: center;
  }

  .col-tier {
    width: 19%;
    text-align: center;
  }

  .th-tier-name {
    display: block;
    font-family: var(--font-serif);
    font-size: 1.25rem;
    font-weight: 600;
  }

  .th-tier-price {
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--text-headline);
  }

  .tier-complete {
    background: var(--sage-100) !important;
    border-left: 2px solid var(--sage-700);
    border-right: 2px solid var(--sage-700);
    position: relative;
  }

  .th-badge {
    display: inline-block;
    background: var(--terracotta);
    color: #FFFFFF;
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    padding: 0.15rem 0.5rem;
    border-radius: var(--radius-pill);
    margin-bottom: 0.25rem;
  }

  .comparison-table td {
    padding: 1rem 1rem;
    border-bottom: 1px solid var(--border-light);
    font-size: 0.925rem;
  }

  .row-even {
    background: #FFFFFF;
  }

  .row-odd {
    background: var(--bg-surface-subtle);
  }

  .cell-title {
    color: var(--text-headline);
  }

  .cell-subtitle {
    color: var(--text-muted);
    font-size: 0.85rem;
    font-style: italic;
  }

  .cell-meta {
    font-size: 0.775rem;
    color: var(--sage-700);
    margin-top: 0.2rem;
  }

  .cell-val {
    text-align: center;
    color: var(--text-muted);
    font-weight: 500;
  }

  .cell-mark {
    text-align: center;
  }

  .cell-complete-col {
    background: rgba(230, 236, 227, 0.45);
    border-left: 1px solid var(--sage-200);
    border-right: 1px solid var(--sage-200);
  }

  .check-mark {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 26px;
    height: 26px;
    background: var(--sage-100);
    color: var(--sage-800);
    border-radius: 50%;
  }

  .check-complete {
    background: var(--sage-700);
    color: #FFFFFF;
  }

  .dash-mark {
    color: var(--text-light);
    font-size: 1.25rem;
    font-weight: 600;
  }

  /* Totals row */
  .row-totals {
    background: var(--bg-surface-subtle);
    border-top: 2px solid var(--border-medium);
  }

  .row-totals td {
    padding: 1.25rem 1rem;
  }

  .total-box {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.15rem;
  }

  .total-val {
    font-size: 0.85rem;
    text-decoration: line-through;
    color: var(--text-light);
  }

  .total-price {
    font-weight: 700;
    font-size: 1.1rem;
    color: var(--text-headline);
  }

  .total-save {
    font-size: 0.775rem;
    font-weight: 600;
    color: var(--success-green);
    background: var(--success-bg);
    padding: 0.15rem 0.5rem;
    border-radius: var(--radius-pill);
  }

  /* Mobile Views */
  .desktop-only {
    display: block;
  }
  .mobile-only {
    display: none;
  }

  @media (max-width: 768px) {
    .desktop-only {
      display: none;
    }
    .mobile-only {
      display: flex;
      flex-direction: column;
      gap: 1.5rem;
    }

    .mobile-matrix-card {
      background: #FFFFFF;
      border: 1px solid var(--border-medium);
      border-radius: var(--radius-lg);
      box-shadow: var(--shadow-card);
      overflow: hidden;
    }

    .matrix-header-row {
      display: grid;
      grid-template-columns: 1fr 68px 84px;
      align-items: center;
      background: var(--bg-surface-subtle);
      border-bottom: 2px solid var(--border-medium);
      padding: 0.85rem 0.65rem;
    }

    .m-header-label {
      font-size: 0.75rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      color: var(--text-muted);
    }

    .m-col-tier {
      display: flex;
      flex-direction: column;
      align-items: center;
      text-align: center;
    }

    .m-tier-title {
      font-size: 0.85rem;
      font-weight: 700;
      color: var(--text-headline);
      line-height: 1.2;
    }

    .m-tier-price {
      font-size: 0.95rem;
      font-weight: 700;
      color: var(--text-headline);
    }

    .m-tier-badge {
      font-size: 0.6rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.04em;
      color: var(--sage-900);
      background: var(--sage-100);
      padding: 0.15rem 0.45rem;
      border-radius: var(--radius-pill);
      margin-bottom: 0.2rem;
    }

    .matrix-row {
      display: grid;
      grid-template-columns: 1fr 68px 84px;
      align-items: center;
      padding: 0.7rem 0.65rem;
      border-bottom: 1px solid var(--border-light);
    }

    .matrix-row-even {
      background: #FFFFFF;
    }

    .matrix-row-odd {
      background: var(--bg-surface-subtle);
    }

    .m-col-resource {
      display: flex;
      flex-direction: column;
      gap: 0.15rem;
      padding-right: 0.5rem;
    }

    .m-res-name {
      font-size: 0.8rem;
      font-weight: 600;
      color: var(--text-headline);
      line-height: 1.35;
    }

    .m-res-val {
      font-size: 0.7rem;
      color: var(--text-light);
    }

    .highlight-col {
      background: rgba(75, 94, 78, 0.04);
      padding-top: 0.25rem;
      padding-bottom: 0.25rem;
      border-radius: var(--radius-sm);
    }

    .m-check-icon {
      width: 20px;
      height: 20px;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .check-starter {
      background: var(--sage-100);
      color: var(--sage-800);
    }

    .check-complete {
      background: var(--sage-700);
      color: #FFFFFF;
    }

    .m-dash {
      color: var(--text-light);
      font-size: 1.1rem;
      line-height: 1;
    }

    .matrix-footer-row {
      display: grid;
      grid-template-columns: 1fr 68px 84px;
      align-items: center;
      padding: 0.85rem 0.65rem;
      background: var(--bg-surface-subtle);
      border-top: 2px solid var(--border-medium);
    }

    .m-footer-title {
      font-size: 0.8rem;
      font-weight: 700;
      color: var(--text-headline);
    }

    .m-footer-sub {
      font-size: 0.675rem;
      color: var(--text-muted);
    }

    .m-footer-val {
      font-size: 0.725rem;
      color: var(--text-light);
      text-decoration: line-through;
    }

    .m-footer-price {
      font-size: 0.9rem;
      font-weight: 700;
      color: var(--text-headline);
    }

    .m-footer-save {
      font-size: 0.65rem;
      font-weight: 700;
      color: var(--sage-900);
      background: var(--sage-100);
      padding: 0.1rem 0.35rem;
      border-radius: var(--radius-pill);
      margin-top: 0.15rem;
    }
  }

  .comparison-summary-sentence {
    margin-top: 2rem;
    padding: 1.25rem 1.5rem;
    background: var(--sage-50);
    border-left: 3px solid var(--sage-700);
    border-radius: 0 var(--radius-md) var(--radius-md) 0;
    text-align: center;
  }

  .comparison-summary-sentence p {
    font-size: 1.05rem;
    line-height: 1.6;
    color: var(--text-headline);
    font-weight: 500;
    margin: 0;
  }
</style>
