---
// Comprehensive Comparison Table & Mobile Single-Card Tier Switcher
// Desktop: Side-by-side 11-row table.
// Mobile: Single-card view (1 card at a time) with segmented toggle & touch swipe support.
import { offerConfig, STARTER_ITEMS, COMPLETE_EXCLUSIVE_ITEMS } from '../../config/offer';

const allItems = [
  ...STARTER_ITEMS.map(i => ({ ...i, inStarter: true, inComplete: true })),
  ...COMPLETE_EXCLUSIVE_ITEMS.map(i => ({ ...i, inStarter: false, inComplete: true }))
];

const starterVal = offerConfig.starter.estimatedValue; // $66
const starterPrice = offerConfig.starter.price; // $17
const completeVal = offerConfig.complete.estimatedValue; // $132
const completePrice = offerConfig.complete.price; // $47
---

<section class="section section-comparison" id="comparison">
  <div class="container">
    <div class="section-header">
      <span class="section-label">Side-by-Side Breakdown</span>
      <h2>Compare Starter vs Complete</h2>
      <p>
        Every single guide, checklist, template, and resource laid out transparently.
      </p>
    </div>

    <!-- Desktop Table View (Hidden on mobile) -->
    <div class="comparison-table-wrapper desktop-only">
      <table class="comparison-table" aria-label="Feature comparison between Starter and Complete">
        <thead>
          <tr>
            <th class="col-item" scope="col">Included Resource</th>
            <th class="col-val" scope="col">Est. Value</th>
            <th class="col-tier tier-starter" scope="col">
              <span class="th-tier-name">Starter</span>
              <span class="th-tier-price">${starterPrice}</span>
            </th>
            <th class="col-tier tier-complete" scope="col">
              <span class="th-badge">Best Value</span>
              <span class="th-tier-name">Complete</span>
              <span class="th-tier-price">${completePrice}</span>
            </th>
          </tr>
        </thead>
        <tbody>
          {allItems.map((item, idx) => (
            <tr class={idx % 2 === 0 ? 'row-even' : 'row-odd'}>
              <td class="cell-title">
                <strong>{item.title}</strong>
                {item.subtitle && <span class="cell-subtitle"> {item.subtitle}</span>}
                <div class="cell-meta">
                  {item.pages && <span>{item.pages} pages</span>}
                  {item.templatesCount && <span>{item.templatesCount} templates</span>}
                  {item.videosCount && <span>{item.videosCount} curated videos</span>}
                  {item.promptsCount && <span>{item.promptsCount}+ prompts</span>}
                </div>
              </td>
              <td class="cell-val">${item.estimatedValue}</td>
              <td class="cell-mark">
                {item.inStarter ? (
                  <span class="check-mark" aria-label="Included in Starter">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                      <polyline points="20 6 9 17 4 12"></polyline>
                    </svg>
                  </span>
                ) : (
                  <span class="dash-mark" aria-label="Not included">&mdash;</span>
                )}
              </td>
              <td class="cell-mark cell-complete-col">
                <span class="check-mark check-complete" aria-label="Included in Complete">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                    <polyline points="20 6 9 17 4 12"></polyline>
                  </svg>
                </span>
              </td>
            </tr>
          ))}
        </tbody>
        <tfoot>
          <!-- Totals Row -->
          <tr class="row-totals">
            <td class="cell-title"><strong>Total Estimated Value</strong></td>
            <td class="cell-val"></td>
            <td class="cell-mark">
              <div class="total-box">
                <span class="total-val">${starterVal}</span>
                <span class="total-price">Your price: ${starterPrice}</span>
                <span class="total-save">Save ${starterVal - starterPrice} (74%)</span>
              </div>
            </td>
            <td class="cell-mark cell-complete-col">
              <div class="total-box total-complete-box">
                <span class="total-val">${completeVal}</span>
                <span class="total-price">Your price: ${completePrice}</span>
                <span class="total-save save-complete">Save ${completeVal - completePrice} (64%)</span>
              </div>
            </td>
          </tr>
        </tfoot>
      </table>
    </div>

    <!-- Mobile Single-Card Tier Breakdown (1 Card at a Time) -->
    <div class="comparison-mobile-container mobile-only">
      <!-- Segmented Switcher for Comparison -->
      <div class="comparison-mobile-switcher" role="tablist" aria-label="Select comparison tier">
        <button
          type="button"
          class="comp-switcher-tab active"
          role="tab"
          aria-selected="true"
          data-comp-target="complete"
          id="comp-tab-complete"
        >
          <span class="comp-tab-label">Complete</span>
          <span class="comp-tab-price">${completePrice}</span>
          <span class="comp-tab-badge">Best Value</span>
        </button>
        <button
          type="button"
          class="comp-switcher-tab"
          role="tab"
          aria-selected="false"
          data-comp-target="starter"
          id="comp-tab-starter"
        >
          <span class="comp-tab-label">Starter</span>
          <span class="comp-tab-price">${starterPrice}</span>
        </button>
      </div>

      <div class="comp-mobile-hint">
        <span>Swipe card or tap tabs above to compare</span>
      </div>

      <!-- Mobile Cards Track: Shows only 1 Card at a Time -->
      <div class="comp-cards-track" id="comp-cards-track">
        <!-- COMPLETE COMPARISON CARD -->
        <div class="comp-mobile-card comp-card-complete active" id="comp-card-complete">
          <div class="comp-card-badge-header">
            <span class="comp-step-badge">Card 1 of 2</span>
            <span class="comp-badge-highlight">Best Value &bull; All 11 Deliverables</span>
          </div>

          <div class="comp-card-head">
            <h3 class="comp-tier-title">Complete Kit Breakdown</h3>
            <p class="comp-tier-sub">Everything needed to choose, launch, and execute with zero guesswork.</p>
          </div>

          <div class="comp-items-list">
            <div class="comp-list-title">All 11 Inclusions in Complete:</div>
            {allItems.map((item) => (
              <div class="comp-item-row">
                <div class="comp-item-icon icon-complete">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                    <polyline points="20 6 9 17 4 12"></polyline>
                  </svg>
                </div>
                <div class="comp-item-text">
                  <div class="comp-item-name-line">
                    <span class="comp-item-name">{item.title}</span>
                    <span class="comp-item-val">Est. ${item.estimatedValue}</span>
                  </div>
                  <div class="comp-item-meta">
                    {item.pages && <span>{item.pages} pages</span>}
                    {item.templatesCount && <span>{item.templatesCount} templates</span>}
                    {item.videosCount && <span>{item.videosCount} curated videos</span>}
                    {item.promptsCount && <span>{item.promptsCount}+ prompts</span>}
                    {!item.inStarter && <span class="badge-exclusive">Complete Exclusive</span>}
                  </div>
                </div>
              </div>
            ))}
          </div>

          <div class="comp-card-totals">
            <div class="comp-total-row">
              <span class="comp-total-label">Total Estimated Value:</span>
              <span class="comp-total-val-strikethrough">${completeVal}</span>
            </div>
            <div class="comp-price-row">
              <span class="comp-price-label">Your One-Time Price:</span>
              <span class="comp-price-val">${completePrice}</span>
            </div>
            <div class="comp-savings-badge">
              Save ${completeVal - completePrice} (64% Off Value)
            </div>
          </div>

          <div class="comp-switch-footer">
            <button type="button" class="btn-comp-switch" data-switch-comp="starter">
              View Starter Kit inclusions ($17) &rarr;
            </button>
          </div>
        </div>

        <!-- STARTER COMPARISON CARD -->
        <div class="comp-mobile-card comp-card-starter" id="comp-card-starter">
          <div class="comp-card-badge-header">
            <span class="comp-step-badge">Card 2 of 2</span>
            <span class="comp-badge-neutral">Foundation Level &bull; 6 Core Inclusions</span>
          </div>

          <div class="comp-card-head">
            <h3 class="comp-tier-title">Starter Kit Breakdown</h3>
            <p class="comp-tier-sub">Essential guides, templates, and zero-dollar blueprints to pick your direction.</p>
          </div>

          <div class="comp-items-list">
            <div class="comp-list-title">6 Inclusions in Starter:</div>
            {STARTER_ITEMS.map((item) => (
              <div class="comp-item-row">
                <div class="comp-item-icon icon-starter">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                    <polyline points="20 6 9 17 4 12"></polyline>
                  </svg>
                </div>
                <div class="comp-item-text">
                  <div class="comp-item-name-line">
                    <span class="comp-item-name">{item.title}</span>
                    <span class="comp-item-val">Est. ${item.estimatedValue}</span>
                  </div>
                  <div class="comp-item-meta">
                    {item.pages && <span>{item.pages} pages</span>}
                    {item.templatesCount && <span>{item.templatesCount} templates</span>}
                  </div>
                </div>
              </div>
            ))}
          </div>

          <!-- Notice of what Complete adds -->
          <div class="comp-not-included-box">
            <div class="not-included-title">What Complete Adds (+5 Items):</div>
            <ul class="not-included-list">
              <li>Step-by-Step Execution Guide (38 pages)</li>
              <li>30-Day Momentum Roadmap (13 pages)</li>
              <li>9 Commercial Pitch Scripts (21 pages)</li>
              <li>Video Tutorial Library (21 lessons)</li>
              <li>High-Leverage AI Prompt Pack (60+ prompts)</li>
            </ul>
          </div>

          <div class="comp-card-totals">
            <div class="comp-total-row">
              <span class="comp-total-label">Total Estimated Value:</span>
              <span class="comp-total-val-strikethrough">${starterVal}</span>
            </div>
            <div class="comp-price-row">
              <span class="comp-price-label">Your One-Time Price:</span>
              <span class="comp-price-val">${starterPrice}</span>
            </div>
            <div class="comp-savings-badge">
              Save ${starterVal - starterPrice} (74% Off Value)
            </div>
          </div>

          <div class="comp-switch-footer">
            <button type="button" class="btn-comp-switch" data-switch-comp="complete">
              View Complete Kit inclusions ($47) &rarr;
            </button>
          </div>
        </div>
      </div>
    </div>

    <!-- Required Summary Sentence Below Comparison Table -->
    <div class="comparison-summary-sentence">
      <p>
        Starter helps you choose and get set up. Complete adds the step-by-step instructions, a 30-day plan, templates, videos and AI prompts to follow through.
      </p>
    </div>
  </div>
</section>

<style>
  .section-comparison {
    background-color: var(--bg-page);
    border-bottom: 1px solid var(--border-light);
  }

  /* Desktop Table Styling */
  .comparison-table-wrapper {
    background: #FFFFFF;
    border: 1px solid var(--border-medium);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-card);
    overflow: hidden;
  }

  .comparison-table {
    width: 100%;
    border-collapse: collapse;
    text-align: left;
  }

  .comparison-table th {
    background-color: #FAF8F5;
    padding: 1.25rem 1rem;
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--text-headline);
    border-bottom: 2px solid var(--border-medium);
    vertical-align: middle;
  }

  .col-item {
    width: 52%;
    padding-left: 1.75rem !important;
  }

  .col-val {
    width: 14%;
    text-align: center;
    color: var(--text-muted);
  }

  .col-tier {
    width: 17%;
    text-align: center;
  }

  .th-tier-name {
    display: block;
    font-size: 1rem;
    font-weight: 700;
  }

  .th-tier-price {
    display: block;
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--sage-800);
    margin-top: 0.2rem;
  }

  .th-badge {
    display: inline-block;
    font-size: 0.65rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    background: var(--sage-100);
    color: var(--sage-900);
    padding: 0.2rem 0.5rem;
    border-radius: var(--radius-pill);
    margin-bottom: 0.35rem;
  }

  .tier-complete {
    background-color: var(--sage-50) !important;
    border-left: 1px solid var(--border-medium);
  }

  .comparison-table td {
    padding: 1.1rem 1rem;
    border-bottom: 1px solid var(--border-light);
    vertical-align: middle;
  }

  .row-even {
    background-color: #FFFFFF;
  }

  .row-odd {
    background-color: #FDFCFA;
  }

  .cell-title {
    padding-left: 1.75rem !important;
  }

  .cell-title strong {
    color: var(--text-headline);
    font-size: 0.925rem;
    display: block;
  }

  .cell-subtitle {
    font-size: 0.825rem;
    color: var(--text-muted);
    font-style: italic;
  }

  .cell-meta {
    display: flex;
    gap: 0.5rem;
    margin-top: 0.25rem;
  }

  .cell-meta span {
    font-size: 0.725rem;
    color: var(--text-light);
    background: var(--bg-surface-subtle);
    padding: 0.1rem 0.4rem;
    border-radius: var(--radius-sm);
  }

  .cell-val {
    text-align: center;
    font-size: 0.875rem;
    color: var(--text-muted);
    font-weight: 500;
  }

  .cell-mark {
    text-align: center;
  }

  .cell-complete-col {
    background-color: rgba(75, 94, 78, 0.02);
    border-left: 1px solid var(--border-light);
  }

  .check-mark {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: var(--sage-100);
    color: var(--sage-800);
  }

  .check-complete {
    background: var(--sage-700);
    color: #FFFFFF;
  }

  .dash-mark {
    color: var(--text-light);
    font-size: 1.25rem;
  }

  /* Table Totals Row */
  .row-totals td {
    padding: 1.5rem 1rem;
    background-color: #FAF8F5;
    border-top: 2px solid var(--border-medium);
    border-bottom: none;
  }

  .total-box {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.2rem;
  }

  .total-val {
    font-size: 0.85rem;
    color: var(--text-muted);
    text-decoration: line-through;
  }

  .total-price {
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--text-headline);
  }

  .total-save {
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--sage-800);
    background: var(--sage-100);
    padding: 0.15rem 0.5rem;
    border-radius: var(--radius-pill);
    margin-top: 0.25rem;
  }

  .save-complete {
    background: var(--sage-200);
    color: var(--sage-900);
  }

  /* ========================================================
     MOBILE ONLY: Strictly 1 Card in View at a Time
     ======================================================== */
  .comparison-mobile-container {
    display: none;
  }

  @media (max-width: 819px) {
    .comparison-table-wrapper {
      display: none !important;
    }

    .comparison-mobile-container {
      display: block;
      max-width: 540px;
      margin: 0 auto;
    }

    /* Segmented Switcher */
    .comparison-mobile-switcher {
      display: flex;
      background: #EBE7DF;
      padding: 0.35rem;
      border-radius: var(--radius-pill);
      gap: 0.35rem;
      max-width: 340px;
      margin: 0 auto 0.75rem;
      box-shadow: inset 0 1px 3px rgba(0, 0, 0, 0.06);
    }

    .comp-switcher-tab {
      flex: 1;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 0.4rem;
      padding: 0.65rem 0.75rem;
      border-radius: var(--radius-pill);
      border: none;
      background: transparent;
      cursor: pointer;
      font-family: inherit;
      transition: all 0.2s ease;
      color: var(--text-muted);
    }

    .comp-switcher-tab.active {
      background: #FFFFFF;
      color: var(--text-headline);
      box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
    }

    .comp-tab-label {
      font-size: 0.85rem;
      font-weight: 700;
    }

    .comp-tab-price {
      font-size: 0.85rem;
      font-weight: 700;
      color: var(--text-headline);
    }

    .comp-tab-badge {
      font-size: 0.6rem;
      font-weight: 700;
      text-transform: uppercase;
      background: var(--sage-100);
      color: var(--sage-900);
      padding: 0.15rem 0.4rem;
      border-radius: var(--radius-pill);
      letter-spacing: 0.03em;
    }

    .comp-mobile-hint {
      text-align: center;
      font-size: 0.75rem;
      color: var(--text-light);
      margin-bottom: 1.25rem;
    }

    /* Cards Track */
    .comp-cards-track {
      width: 100%;
    }

    /* Single Card Display: active shows, inactive hides */
    .comp-mobile-card {
      display: none;
      background: #FFFFFF;
      border: 1px solid var(--border-medium);
      border-radius: var(--radius-lg);
      padding: 1.5rem 1.25rem;
      box-shadow: var(--shadow-card);
    }

    .comp-mobile-card.active {
      display: block;
      animation: fadeInCard 0.2s ease-in-out;
    }

    @keyframes fadeInCard {
      from { opacity: 0; transform: translateY(4px); }
      to { opacity: 1; transform: translateY(0); }
    }

    .comp-card-complete {
      border: 1.5px solid var(--sage-700);
    }

    .comp-card-badge-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 0.5rem;
      margin-bottom: 1rem;
    }

    .comp-step-badge {
      font-size: 0.7rem;
      font-weight: 700;
      color: var(--text-muted);
      background: var(--bg-surface-subtle);
      padding: 0.2rem 0.5rem;
      border-radius: var(--radius-pill);
      border: 1px solid var(--border-light);
    }

    .comp-badge-highlight {
      font-size: 0.7rem;
      font-weight: 700;
      text-transform: uppercase;
      color: var(--sage-900);
      background: var(--sage-100);
      padding: 0.2rem 0.6rem;
      border-radius: var(--radius-pill);
      border: 1px solid var(--sage-300);
    }

    .comp-badge-neutral {
      font-size: 0.7rem;
      font-weight: 700;
      text-transform: uppercase;
      color: var(--text-muted);
      background: var(--bg-surface-subtle);
      padding: 0.2rem 0.6rem;
      border-radius: var(--radius-pill);
      border: 1px solid var(--border-light);
    }

    .comp-card-head {
      margin-bottom: 1.25rem;
      border-bottom: 1px solid var(--border-light);
      padding-bottom: 0.85rem;
    }

    .comp-tier-title {
      font-size: 1.2rem;
      font-weight: 700;
      color: var(--text-headline);
      margin-bottom: 0.25rem;
    }

    .comp-tier-sub {
      font-size: 0.825rem;
      color: var(--text-muted);
      line-height: 1.45;
      margin: 0;
    }

    .comp-list-title {
      font-size: 0.75rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      color: var(--sage-800);
      margin-bottom: 0.85rem;
    }

    .comp-items-list {
      display: flex;
      flex-direction: column;
      gap: 0.75rem;
      margin-bottom: 1.25rem;
    }

    .comp-item-row {
      display: flex;
      align-items: flex-start;
      gap: 0.65rem;
      padding-bottom: 0.65rem;
      border-bottom: 1px solid var(--border-light);
    }

    .comp-item-row:last-child {
      border-bottom: none;
      padding-bottom: 0;
    }

    .comp-item-icon {
      width: 22px;
      height: 22px;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
      margin-top: 0.1rem;
    }

    .icon-complete {
      background: var(--sage-700);
      color: #FFFFFF;
    }

    .icon-starter {
      background: var(--sage-100);
      color: var(--sage-800);
    }

    .comp-item-text {
      flex: 1;
      min-width: 0;
    }

    .comp-item-name-line {
      display: flex;
      justify-content: space-between;
      align-items: baseline;
      gap: 0.4rem;
    }

    .comp-item-name {
      font-size: 0.85rem;
      font-weight: 600;
      color: var(--text-headline);
      line-height: 1.35;
    }

    .comp-item-val {
      font-size: 0.75rem;
      color: var(--text-muted);
      flex-shrink: 0;
    }

    .comp-item-meta {
      display: flex;
      flex-wrap: wrap;
      gap: 0.35rem;
      margin-top: 0.2rem;
    }

    .comp-item-meta span {
      font-size: 0.7rem;
      color: var(--text-light);
      background: var(--bg-surface-subtle);
      padding: 0.05rem 0.35rem;
      border-radius: var(--radius-sm);
    }

    .badge-exclusive {
      color: var(--sage-900) !important;
      background: var(--sage-100) !important;
      font-weight: 600;
    }

    /* What Complete Adds Callout in Starter Card */
    .comp-not-included-box {
      background: var(--bg-surface-subtle);
      border: 1px dashed var(--border-medium);
      border-radius: var(--radius-md);
      padding: 0.85rem 1rem;
      margin-bottom: 1.25rem;
    }

    .not-included-title {
      font-size: 0.75rem;
      font-weight: 700;
      color: var(--text-muted);
      text-transform: uppercase;
      margin-bottom: 0.4rem;
    }

    .not-included-list {
      list-style: none;
      padding: 0;
      margin: 0;
      display: flex;
      flex-direction: column;
      gap: 0.25rem;
      font-size: 0.785rem;
      color: var(--text-muted);
    }

    .not-included-list li::before {
      content: "+ ";
      color: var(--sage-800);
      font-weight: 700;
    }

    /* Totals Box */
    .comp-card-totals {
      background: var(--bg-surface-subtle);
      border: 1px solid var(--border-medium);
      border-radius: var(--radius-md);
      padding: 0.85rem 1rem;
      text-align: center;
      margin-top: 1rem;
    }

    .comp-total-row {
      display: flex;
      justify-content: space-between;
      font-size: 0.8rem;
      color: var(--text-muted);
      margin-bottom: 0.3rem;
    }

    .comp-total-val-strikethrough {
      text-decoration: line-through;
    }

    .comp-price-row {
      display: flex;
      justify-content: space-between;
      align-items: baseline;
      font-size: 1rem;
      font-weight: 700;
      color: var(--text-headline);
