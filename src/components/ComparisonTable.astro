<script is:inline>
  (function initComparisonMobileSwitcher() {
    var tabs = document.querySelectorAll('.comp-switcher-tab');
    var completeCard = document.getElementById('comp-card-complete');
    var starterCard = document.getElementById('comp-card-starter');
    var switchBtns = document.querySelectorAll('.btn-comp-switch');
    var track = document.getElementById('comp-cards-track');
    if (!tabs.length || !completeCard || !starterCard) return;

    function setComparisonTier(tier) {
      tabs.forEach(function (tab) {
        var isMatch = tab.getAttribute('data-comp-target') === tier;
        tab.classList.toggle('active', isMatch);
        tab.setAttribute('aria-selected', isMatch ? 'true' : 'false');
      });

      if (tier === 'starter') {
        completeCard.classList.remove('active');
        starterCard.classList.add('active');
      } else {
        starterCard.classList.remove('active');
        completeCard.classList.add('active');
      }
    }

    tabs.forEach(function (tab) {
      tab.addEventListener('click', function () {
        var targetTier = tab.getAttribute('data-comp-target') || 'complete';
        setComparisonTier(targetTier);
      });
    });

    switchBtns.forEach(function (btn) {
      btn.addEventListener('click', function () {
        var targetTier = btn.getAttribute('data-switch-comp') || 'complete';
        setComparisonTier(targetTier);
        var targetCard = targetTier === 'starter' ? starterCard : completeCard;
        if (targetCard) {
          targetCard.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
      });
    });

    // Touch swipe support for Comparison mobile cards
    if (track) {
      var touchStartX = 0;
      var touchStartY = 0;
      track.addEventListener('touchstart', function (e) {
        if (!e.changedTouches || e.changedTouches.length === 0) return;
        touchStartX = e.changedTouches[0].clientX;
        touchStartY = e.changedTouches[0].clientY;
      }, { passive: true });

      track.addEventListener('touchend', function (e) {
        if (!e.changedTouches || e.changedTouches.length === 0) return;
        var diffX = e.changedTouches[0].clientX - touchStartX;
        var diffY = e.changedTouches[0].clientY - touchStartY;
        if (Math.abs(diffX) > 45 && Math.abs(diffX) > Math.abs(diffY)) {
          if (diffX < 0) {
            // Swiped left -> switch to starter
            setComparisonTier('starter');
          } else {
            // Swiped right -> switch to complete
            setComparisonTier('complete');
          }
        }
      }, { passive: true });
    }
  })();
</script>
