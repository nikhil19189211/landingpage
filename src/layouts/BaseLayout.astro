---
// Base Layout for Landing Page
import AnnouncementBar from '../components/AnnouncementBar.astro';
import Footer from '../components/Footer.astro';
import StickyMobileCTA from '../components/StickyMobileCTA.astro';
import CookieBanner from '../components/CookieBanner.astro';
import RecentPurchaseToast from '../components/RecentPurchaseToast.astro';
import { offerConfig } from '../../config/offer';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Her First Income | Practical Blueprints to Build Real At-Home Income",
  description = "A calm, honest guide to choosing and launching one legitimate at-home income path. Zero hype, free tool setups, and 145 fill-in templates."
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="p:domain_verify" content="d93f8a8f5e6656588d2ae7d1748e51d9" />
    <title>{title}</title>

    <!-- SEO & Social Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="/images/mockups/starter-pack-landscape.jpg" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content="/images/mockups/starter-pack-landscape.jpg" />

    <!-- Preload Self-Hosted Font -->
    <link 
      rel="preload" 
      href="/fonts/playfair-display.woff2" 
      as="font" 
      type="font/woff2" 
      crossorigin 
    />

    <!-- Dual Client Tracker -->
    <script src="/tracker.js" defer></script>

    <!-- Gumroad Overlay Checkout Modal -->
    <script src="https://gumroad.com/js/gumroad.js" defer></script>

    <!-- Meta Pixel Code -->
    <script is:inline>
      !function(f,b,e,v,n,t,s)
      {if(f.fbq)return;n=f.fbq=function(){n.callMethod?
      n.callMethod.apply(n,arguments):n.queue.push(arguments)};
      if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';
      n.queue=[];t=b.createElement(e);t.async=!0;
      t.src=v;s=b.getElementsByTagName(e)[0];
      s.parentNode.insertBefore(t,s)}(window, document,'script',
      'https://connect.facebook.net/en_US/fbevents.js');
      fbq('init', '1195368395361870');
      fbq('track', 'PageView');
    </script>
    <noscript>
      <img height="1" width="1" style="display:none"
           src="https://www.facebook.com/tr?id=1195368395361870&ev=PageView&noscript=1" alt="" />
    </noscript>
    <!-- End Meta Pixel Code -->
  </head>
  <body>
    <AnnouncementBar />

    <main id="main-content">
      <slot />
    </main>

    <Footer />
    <StickyMobileCTA />
    <CookieBanner />
    <RecentPurchaseToast />
  </body>
</html>
