    display: flex;
    align-items: flex-start;
    gap: 0.65rem;
    font-size: 0.875rem;
    line-height: 1.45;
  }

  .item-check-owned {
    flex-shrink: 0;
    width: 20px;
    height: 20px;
    border-radius: 50%;
    background: var(--bg-surface-subtle);
    color: var(--text-muted);
    display: flex;
    align-items: center;
    justify-content: center;
